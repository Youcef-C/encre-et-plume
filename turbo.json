{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "stream",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "lint": {},
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"]
    },
    "e2e": {
      "dependsOn": ["^build"],
      "outputs": ["playwright-report/**"],
      "passThroughEnv": [
        "CI",
        "DATABASE_URL",
        "REDIS_URL",
        "JWT_SECRET",
        "API_PORT",
        "WEB_ORIGIN",
        "NEXT_PUBLIC_API_URL",
        "S3_ENDPOINT",
        "S3_REGION",
        "S3_BUCKET",
        "S3_ACCESS_KEY_ID",
        "S3_SECRET_ACCESS_KEY",
        "CDN_BASE_URL",
        "MEDIA_SIGNED_URL_TTL",
        "DISABLE_RATE_LIMIT"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
