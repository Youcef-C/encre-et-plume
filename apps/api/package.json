{
  "name": "@encre-et-plume/api",
  "version": "0.0.0",
  "private": true,
  "description": "NestJS 11 backend (REST + WS, Prisma 6).",
  "scripts": {
    "postinstall": "prisma generate",
    "build": "nest build",
    "start": "node dist/main.js",
    "dev": "nest start --watch",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "worker": "nest start --watch --entryFile worker",
    "start:worker": "node dist/worker.js",
    "test": "jest",
    "test:cov": "jest --coverage"
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1076.0",
    "@aws-sdk/s3-request-presigner": "^3.1076.0",
    "@encre-et-plume/shared": "workspace:*",
    "@nestjs/common": "^11.1.27",
    "@nestjs/core": "^11.1.27",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/platform-express": "^11.1.27",
    "@prisma/client": "^6.10.1",
    "@sentry/node": "^10.62.0",
    "bcryptjs": "^2.4.3",
    "bullmq": "^5",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "cookie-parser": "^1.4.7",
    "dotenv": "^16.4.7",
    "helmet": "^8.2.0",
    "ioredis": "^5.6.1",
    "jszip": "^3.10.1",
    "nodemailer": "^9.0.3",
    "prom-client": "^15.1.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "sharp": "^0.35.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@nestjs/cli": "^11.0.23",
    "@nestjs/schematics": "^11.1.0",
    "@nestjs/testing": "^11.1.27",
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.8",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.1.0",
    "@types/nodemailer": "^8.0.1",
    "@types/sharp": "^0.32.0",
    "@types/supertest": "^7.2.0",
    "eslint": "^10.6.0",
    "globals": "^17.7.0",
    "jest": "^30.4.2",
    "prisma": "^7.8.0",
    "supertest": "^7.1.0",
    "ts-jest": "^29.2.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.18.0"
  }
}
