// F-1: account sign-up & login. F-3 extends Profile. F-5 adds Notification. F-10 adds Media.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  utilisateur
  maintainer
  editor
  admin
}

enum NotifType {
  message
  application
  report
  invitation
  project_activity
  release
  like
  comment
}

// ── F-10 Media enums ──────────────────────────────────────────────────────────

enum MediaKind {
  avatar
  cover
  portfolio
  chapter_page
  illustration
  attachment
  article
  contest
}

enum MediaStatus {
  pending
  ready
  failed
}

enum MediaVisibility {
  public
  private
}

model Account {
  id                    String         @id @default(cuid())
  displayName           String
  email                 String         @unique
  passwordHash          String
  role                  Role           @default(utilisateur)
  verified              Boolean        @default(false) // ponytail: flat flag; AD-3 sets it, no separate Editor table
  profileSlug           String         @unique
  avatar                String?
  preferences           Json           @default("{\"theme\":\"system\"}") // F-6: extensible JSON; promote to sub-model if preferences multiply
  createdAt             DateTime       @default(now())
  profile               Profile?
  notificationsReceived Notification[] @relation("NotifRecipient")
  notificationsSent     Notification[] @relation("NotifSource")
  media                 Media[]
}

// ── F-10 Media model ──────────────────────────────────────────────────────────
// CS-3's per-project Asset will reference Media.id; existing URL columns
// (Account.avatar / Profile.coverImage / PortfolioItem.image) keep storing the
// ready public URL — mediaId references are the long-term form.

model Media {
  id          String          @id @default(cuid())
  ownerId     String
  owner       Account         @relation(fields: [ownerId], references: [id])
  kind        MediaKind
  bucketKey   String
  contentType String
  size        Int
  width       Int?
  height      Int?
  status      MediaStatus     @default(pending)
  variants    Json            @default("{}")
  visibility  MediaVisibility @default(public)
  createdAt   DateTime        @default(now())

  @@index([ownerId])
  @@index([status, createdAt])
}

model Profile {
  id                   String          @id @default(cuid())
  accountId            String          @unique
  account              Account         @relation(fields: [accountId], references: [id])
  coverImage           String?
  specialty            String?
  city                 String?
  bio                  String?
  seekingActive        Boolean         @default(false)
  seekingTargetRole    String?
  seekingGenres        String[]        @default([])
  seekingProjectLength String?
  tags                 String[]        @default([])
  portfolio            PortfolioItem[]
  createdAt            DateTime        @default(now())
}

model PortfolioItem {
  id        String   @id @default(cuid())
  profileId String
  profile   Profile  @relation(fields: [profileId], references: [id])
  image     String
  caption   String?
  order     Int      @default(0)
  createdAt DateTime @default(now())
}

model Notification {
  id           String    @id @default(cuid())
  recipientId  String
  recipient    Account   @relation("NotifRecipient", fields: [recipientId], references: [id])
  type         NotifType
  refId        String?
  sourceUserId String?
  sourceUser   Account?  @relation("NotifSource", fields: [sourceUserId], references: [id])
  createdAt    DateTime  @default(now())
  readAt       DateTime?

  @@index([recipientId, readAt])
  @@index([recipientId, createdAt])
}
