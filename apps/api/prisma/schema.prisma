// F-1: account sign-up & login. F-3 extends Profile. F-5 adds Notification. F-10 adds Media.
// F-11 adds EmailVerificationToken. F-12 adds PasswordResetToken. F-13 adds LegalDocument + ConsentRecord.
// F-14 adds DataExport + Account.deletedAt + NotifType.system.
// F-15 adds NotificationPreference. F-17 adds Account.onboardedAt + Profile.creatorRoles.
// F-18 adds TwoFactorCredential + EmailChangeToken.
// DR-1 adds Work, Chapter, Announcement + Profile.trendingScore (home showroom).
// DR-3 extends Work/Chapter + adds WorkCreator, Planche, FundingGoal, Review (work page "Œuvre").
// DR-4 extends Chapter (premium/prose) + Planche (chapterId) + adds Favorite, ReadingProgress (reader).
// MC-8 adds Connection + ConnectionStatus + NotifType.connection_* (contacts & connexions network).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  utilisateur
  maintainer
  editor
  admin
}

enum NotifType {
  message
  application
  report
  invitation
  project_activity
  release
  like
  comment
  system // F-14: system notifications (data export ready, etc.)
  application_accepted // MC-7: owner accepted an applicant
  application_rejected // MC-7: owner rejected an applicant
  connection_request // MC-8: someone sent a connection request
  connection_accepted // MC-8: the recipient accepted the connection request
  group_removed // MC-12: the group creator removed you from a group
}

// ── DR-1 Work/Chapter/Announcement enums ───────────────────────────────────────

enum ChapterStatus {
  draft
  scheduled
  published
}

enum AnnouncementType {
  concours
  a_chaud
  evenement
}

// ── F-14 DataExport enum ──────────────────────────────────────────────────────

enum DataExportStatus {
  pending
  ready
  failed
  expired
}

// ── F-10 Media enums ──────────────────────────────────────────────────────────

enum MediaKind {
  avatar
  cover
  portfolio
  chapter_page
  illustration
  attachment
  article
  contest
  call_sample
  application_sample
  call_document
  application_document
}

enum MediaStatus {
  pending
  ready
  failed
}

enum MediaVisibility {
  public
  private
}

// ── F-13 Legal enums ──────────────────────────────────────────────────────────

enum LegalKind {
  cgu
  privacy
  mentions
}

enum ConsentDocument {
  cgu
  privacy
}

model Account {
  id                      String                   @id @default(cuid())
  displayName             String
  email                   String                   @unique
  passwordHash            String
  role                    Role                     @default(utilisateur)
  verified                Boolean                  @default(false) // ponytail: flat flag; AD-3 sets it, no separate Editor table
  profileSlug             String                   @unique
  avatar                  String?
  preferences             Json                     @default("{\"theme\":\"system\"}") // F-6: extensible JSON; promote to sub-model if preferences multiply
  createdAt               DateTime                 @default(now())
  emailVerifiedAt         DateTime? // F-11: null = unverified; set on confirmation
  birthdate               DateTime?                @db.Date // DR-10: RGPD PII, never public; null = not yet declared (prompt on next 18+ access)
  deletedAt               DateTime? // F-14: null = active; non-null = tombstoned (RGPD erasure)
  onboardedAt             DateTime? // F-17: null = show onboarding wizard; set on completion/skip
  profile                 Profile?
  notificationsReceived   Notification[]           @relation("NotifRecipient")
  notificationsSent       Notification[]           @relation("NotifSource")
  notificationPreferences NotificationPreference[]
  media                   Media[]
  emailVerificationTokens EmailVerificationToken[]
  passwordResetTokens     PasswordResetToken[]
  consents                ConsentRecord[] // F-13: append-only acceptance log
  dataExports             DataExport[] // F-14: export requests
  twoFactor               TwoFactorCredential? // F-18: TOTP credential (optional; 1-to-1)
  emailChangeTokens       EmailChangeToken[] // F-18: pending email-change requests
  workCredits             WorkCreator[] // DR-3: works this account is credited on
  favorites               Favorite[] // DR-4: favorited works (reads only; DR-9 owns the toggle write)
  readingProgress         ReadingProgress[] // DR-4: per-chapter reading position (feeds DR-8)
  illustrations           Illustration[] // DR-5: gallery illustrations credited to this artist
  watchlist               WatchlistItem[] // DR-8: saved "Ma liste" works (reads + remove only; DR-9 owns the add)
  reactions               Reaction[] // DR-9: chapter/illustration like+save toggles (works reuse Favorite/WatchlistItem)
  supportTickets          SupportTicket[] // F-21: help/contact/bug tickets submitted while signed in
  projects                Project[]                @relation("ProjectOwner") // CS-1 seam: projects this account owns
  invitationsSent         Invitation[]             @relation("InvitationsSent") // MC-3: collab invites sent
  invitationsReceived     Invitation[]             @relation("InvitationsReceived") // MC-3: collab invites received
  applications            Application[] // MC-5: call applications this account submitted
  connectionsSent         Connection[]             @relation("ConnectionsSent") // MC-8: requests this account initiated
  connectionsReceived     Connection[]             @relation("ConnectionsReceived") // MC-8: requests addressed to this account
  conversationParticipations ConversationParticipant[] // MC-9: conversations this account is a member of
  messagesSent            Message[]                @relation("MessagesSent") // MC-9: messages this account sent
  blocksMade              UserBlock[]              @relation("BlocksMade") // MC-10: block/mute rows this account created
  blocksReceived          UserBlock[]              @relation("BlocksReceived") // MC-10: rows where this account is the target
}

// ── F-10 Media model ──────────────────────────────────────────────────────────

model Media {
  id          String          @id @default(cuid())
  ownerId     String
  owner       Account         @relation(fields: [ownerId], references: [id])
  kind        MediaKind
  bucketKey   String
  contentType String
  size        Int
  width       Int?
  height      Int?
  status      MediaStatus     @default(pending)
  variants    Json            @default("{}")
  visibility  MediaVisibility @default(public)
  createdAt   DateTime        @default(now())
  dataExport  DataExport? // F-14: back-relation (one archive per export)

  @@index([ownerId])
  @@index([status, createdAt])
}

// ── F-14: DataExport ──────────────────────────────────────────────────────────

model DataExport {
  id          String           @id @default(cuid())
  accountId   String
  account     Account          @relation(fields: [accountId], references: [id])
  status      DataExportStatus @default(pending)
  mediaId     String?          @unique
  media       Media?           @relation(fields: [mediaId], references: [id])
  requestedAt DateTime         @default(now())
  readyAt     DateTime?
  expiresAt   DateTime?

  @@index([accountId, status])
  @@index([status, expiresAt]) // purge sweep
}

model Profile {
  id                   String          @id @default(cuid())
  accountId            String          @unique
  account              Account         @relation(fields: [accountId], references: [id])
  coverImage           String?
  specialty            String?
  city                 String?
  bio                  String?
  creatorRoles         String[]        @default([]) // F-17: onboarding Step 1 sub-roles (NOT authz role)
  seekingActive        Boolean         @default(false)
  seekingTargetRole    String?
  seekingGenres        String[]        @default([])
  seekingProjectLength String?
  tags                 String[]        @default([])
  portfolio            PortfolioItem[]
  trendingScore        Int             @default(0) // DR-1: denormalized "of the moment" rank; engagement pipeline recomputes later
  country              String? // MC-1: ISO 3166-1 alpha-2 — directory location unit ('Hors France' bucket retired)
  region               String? // MC-1: FR-only sub-level (one of PARTNER_REGIONS, only when country = 'FR')
  availability         String          @default("ouvert") // MC-1: PARTNER_AVAILABILITY_KEYS — "Dispo" filter
  createdAt            DateTime        @default(now())

  @@index([trendingScore])
  @@index([country]) // MC-1: directory location filter (continent/country tokens)
  @@index([region]) // MC-1: FR-région sub-filter (creatorRoles is an array — GIN not expressible in Prisma, skip at this scale)
}

model PortfolioItem {
  id        String   @id @default(cuid())
  profileId String
  profile   Profile  @relation(fields: [profileId], references: [id])
  image     String
  caption   String?
  order     Int      @default(0)
  createdAt DateTime @default(now())
}

// ── F-11: Email verification token ───────────────────────────────────────────

model EmailVerificationToken {
  id         String    @id @default(cuid())
  accountId  String
  account    Account   @relation(fields: [accountId], references: [id])
  tokenHash  String    @unique // sha256(raw); raw is never stored
  expiresAt  DateTime // createdAt + 24h
  consumedAt DateTime? // single-use: non-null once confirmed
  createdAt  DateTime  @default(now())

  @@index([accountId])
}

// ── F-12: Password reset token (mirrors F-11 EmailVerificationToken; TTL 1h) ──

model PasswordResetToken {
  id         String    @id @default(cuid())
  accountId  String
  account    Account   @relation(fields: [accountId], references: [id])
  tokenHash  String    @unique // sha256(raw); raw is never stored
  expiresAt  DateTime // createdAt + 1h
  consumedAt DateTime? // single-use: non-null once used
  createdAt  DateTime  @default(now())

  @@index([accountId])
}

model Notification {
  id           String    @id @default(cuid())
  recipientId  String
  recipient    Account   @relation("NotifRecipient", fields: [recipientId], references: [id])
  type         NotifType
  refId        String?
  sourceUserId String?
  sourceUser   Account?  @relation("NotifSource", fields: [sourceUserId], references: [id])
  createdAt    DateTime  @default(now())
  readAt       DateTime?

  @@index([recipientId, readAt])
  @@index([recipientId, createdAt])
}

// ── MC-3: Collaboration invitations + CS-1 project seam ───────────────────────

enum InvitationStatus {
  pending
  accepted
  declined
}

// CS-1 seam: minimal project shell so MC-3's picker + ownership validation work.
// CS-1 owns creation/workspace and extends this model (never renames these fields).
model Project {
  id          String       @id @default(cuid())
  ownerId     String
  owner       Account      @relation("ProjectOwner", fields: [ownerId], references: [id])
  title       String
  kind        String       @default("Manga") // "Manga" | "Illustration(s)" | … (picker meta line)
  genre       String? // fr label, e.g. "Seinen" (picker meta line)
  status      String       @default("en cours") // "en cours" | "en révision" | … (picker meta line)
  cover       String? // image URL; null -> halftone placeholder
  slug        String?      @unique // CS-2 workspace address (GET /projects/{slug}); nullable so legacy rows survive
  step        String? // CS-12 dashboard: current production step, e.g. "encrage Ch.1" — CS-2/CS-5 own writing it
  nextReleaseAt DateTime? // CS-12 dashboard: next scheduled release — CS-9 owns writing it
  // CS-1: the Project↔Work bridge. `workId` shares the Project's slug value, so /projet/{slug} and
  // /oeuvre/{slug} resolve to the same pair. Nullable so legacy/seed Projects survive.
  visibility  String       @default("prive") // 'prive' | 'invitation' | 'public' (workspace/collab)
  collabOpen  Boolean      @default(false) // CS-2 "Demandes de collaboration" toggle (distinct from visibility; MC candidature reads it)
  workId      String?      @unique // seeded œuvre (Work) — created in one $transaction with the Project
  work        Work?        @relation(fields: [workId], references: [id])
  createdAt   DateTime     @default(now())
  invitations Invitation[]
  calls       ProjectCall[] // MC-4X req6: calls linked to this project
  pages       Page[] // CS-2 kanban board cards (NOT Planche — see Page model)

  @@index([ownerId])
}

model Invitation {
  id          String           @id @default(cuid())
  fromUserId  String
  fromUser    Account          @relation("InvitationsSent", fields: [fromUserId], references: [id])
  toUserId    String
  toUser      Account          @relation("InvitationsReceived", fields: [toUserId], references: [id])
  projectId   String?
  project     Project?         @relation(fields: [projectId], references: [id])
  message     String           @default("")
  status      InvitationStatus @default(pending)
  createdAt   DateTime         @default(now())
  respondedAt DateTime?

  @@index([fromUserId, status])
  @@index([toUserId, status])
}

// ── MC-8: Contacts & connexions ───────────────────────────────────────────────

enum ConnectionStatus {
  pending
  accepted
  declined
}

// MC-8: one row per user pair. A `pending` row IS the story's ConnectionRequest; an `accepted` row
// IS the mutual Connection. Direction (requester→addressee) matters only while pending.
model Connection {
  id          String           @id @default(cuid())
  requesterId String
  requester   Account          @relation("ConnectionsSent", fields: [requesterId], references: [id])
  addresseeId String
  addressee   Account          @relation("ConnectionsReceived", fields: [addresseeId], references: [id])
  status      ConnectionStatus @default(pending)
  context     String           @default("") // D6: derived French context line, frozen at creation
  createdAt   DateTime         @default(now())
  respondedAt DateTime?

  @@unique([requesterId, addresseeId]) // backstop; service enforces one row per unordered pair
  @@index([addresseeId, status])
  @@index([requesterId, status])
}

// ── MC-9: Messaging (floating widget) ─────────────────────────────────────────
// readBy[] is DERIVED, not stored: message M is read by participant P iff
// P.lastReadAt >= M.createdAt. One timestamp per participant (O(1) mark-read) instead of a
// row per (message × reader). Unread per conversation = messages after my lastReadAt not sent by me.

enum ConversationType {
  dm
  group
  salon // MC-11: one global public room "Le Comptoir"
}

model Conversation {
  id            String                    @id @default(cuid())
  type          ConversationType
  name          String? // group only; DM title is computed per-viewer (the OTHER party)
  projectId     String? // CS-8 seam: a project group chat IS this conversation
  dmKey         String?                   @unique // dm only: "minId:maxId" — DB backstop, one DM per pair
  status        String                    @default("open") // 'open' | 'requested' | 'declined' — DM request lifecycle; groups/salon always 'open'
  requestedBy   String? // accountId of the requester while status != 'open'
  createdBy     String? // MC-12: group owner accountId; null for dm/salon (every group has one)
  createdAt     DateTime                  @default(now())
  lastMessageAt DateTime                  @default(now()) // list ordering key (bumped on each send)
  participants  ConversationParticipant[]
  messages      Message[]

  @@index([projectId])
  @@index([lastMessageAt])
}

model ConversationParticipant {
  conversationId String
  accountId      String
  lastReadAt     DateTime     @default(now()) // unread = messages after this, not sent by me
  createdAt      DateTime     @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  account        Account      @relation(fields: [accountId], references: [id])

  @@id([conversationId, accountId])
  @@index([accountId])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String
  sender         Account      @relation("MessagesSent", fields: [senderId], references: [id])
  body           String       @default("")
  attachments    Json         @default("[]") // MessageAttachment[] denormalized display (mediaId,name,kind)
  attachmentIds  String[]     @default([]) // Media.ids — queryable authz lookup for signed-URL gating (F-10)
  createdAt      DateTime     @default(now())

  @@index([conversationId, createdAt])
}

// ── F-13: Legal documents & consent records ───────────────────────────────────

// ── F-15: Notification & e-mail preferences ──────────────────────────────────

model NotificationPreference {
  id        String  @id @default(cuid())
  accountId String
  account   Account @relation(fields: [accountId], references: [id])
  type      String // NotificationPrefType (string — forward-compatible with new categories)
  channel   String // 'in_app' | 'email'
  enabled   Boolean

  @@unique([accountId, type, channel])
  @@index([accountId])
}

model LegalDocument {
  id          String    @id @default(cuid())
  kind        LegalKind
  version     String
  content     String // trusted HTML
  publishedAt DateTime  @default(now())

  @@unique([kind, version])
  @@index([kind, publishedAt])
}

model ConsentRecord {
  id         String          @id @default(cuid())
  accountId  String
  account    Account         @relation(fields: [accountId], references: [id])
  document   ConsentDocument
  version    String
  acceptedAt DateTime        @default(now())
  ip         String?

  @@index([accountId, document])
}

// ── F-18: 2FA credential (one per account; enabledAt null = pending/unconfirmed) ──

model TwoFactorCredential {
  id               String    @id @default(cuid())
  accountId        String    @unique // one credential per account
  account          Account   @relation(fields: [accountId], references: [id])
  secretEncrypted  String // AES-256-GCM "iv:tag:ciphertext" (base64); never logged
  enabledAt        DateTime? // null = setup pending (secret issued, not confirmed)
  backupCodeHashes String[]  @default([]) // sha256(code) hex; single-use → removed on use
  createdAt        DateTime  @default(now())
}

// ── F-18: Email change token (mirrors F-11 EmailVerificationToken) ────────────

model EmailChangeToken {
  id         String    @id @default(cuid())
  accountId  String
  account    Account   @relation(fields: [accountId], references: [id])
  newEmail   String // committed to Account.email on confirm
  tokenHash  String    @unique // sha256(raw); raw never stored (mirror F-11/F-12)
  expiresAt  DateTime // createdAt + 24h
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([accountId])
}

// ── DR-1: home showroom (Work/Chapter/Announcement) ───────────────────────────
// "ScheduledRelease" and "Creator" from the story's entity list are NOT separate tables:
// a scheduled release IS a Chapter with status=scheduled + publishAt>now; a creator IS an
// existing Account+Profile (role via Profile.creatorRoles, see trendingScore above).

model Work {
  id                 String    @id @default(cuid())
  slug               String    @unique
  title              String
  coverImage         String? // media URL; null → CSS halftone placeholder on FE
  genre              String // display fr label — "Shōnen" | "Seinen" | "Fantastique" | "Josei" | …
  // (DR-2 catalog GENRE facet accepts F-20 vocabulary ids in the
  // query and maps id→fr via catalogGenreLabel() before filtering
  // this column — see catalog.service.ts. Column itself is unchanged
  // from DR-1: kept as the fr display label, reused verbatim by cards.)
  meta               String // hero/ranking meta line, e.g. "Léa B. × Hugo D. · 20 ch."
  likeCount          Int       @default(0) // ponytail: denormalized total; DR-9 owns the increment
  weeklyLikeDelta    Int       @default(0) // ponytail: rolling-7d delta; DR-9/DR-4 recompute from events
  priorWeekLikeDelta Int       @default(0) // ponytail: prior-period delta for growth %; same note
  featuredRank       Int? // null = not in "À LA UNE"; else carousel order asc
  createdAt          DateTime  @default(now())
  chapters           Chapter[]

  // ── DR-2: catalog facet columns ──────────────────────────────────────────
  themes         String[]     @default([]) // CATALOG_THEMES subset (OR-in filter)
  format         String       @default("Manga") // one of CATALOG_FORMATS
  language       String       @default("Français") // one of CATALOG_LANGUAGES
  audienceRating String       @default("Tous publics") // CATALOG_AUDIENCE_RATINGS — DR-10 reads this for 18+ gating
  complete       Boolean      @default(false) // STATUT: true = "Œuvres complètes"
  chapterCount   Int          @default(0) // ponytail: denormalized card count + LONGUEUR filter; DR-3/CS own real counts
  ratingAvg      Float        @default(0) // ponytail: denormalized; PUB-3 reviews own it
  publishedAt    DateTime? // null = not in catalog; non-null = published + recency sort key
  editorPicks    EditorPick[]

  // ── DR-3: work page "Œuvre" columns ──────────────────────────────────────
  synopsis       String? // "Synopsis" block body
  hashtags       String[]      @default([]) // "#..." chips under the synopsis
  proseExcerpt   String? // roman-only excerpt body; response nulls it unless format==='Roman'
  readCount      Int           @default(0) // ponytail: denormalized; DR-4 owns the increment (reader open)
  favoriteCount  Int           @default(0) // ponytail: denormalized; DR-9 owns the increment
  ratingStoryAvg Float         @default(0) // ponytail: recomputed from Review rows in WorksService (not stored authoritative)
  ratingArtAvg   Float         @default(0) // same note
  reviewCount    Int           @default(0) // same note — DR-3 recomputes ratingStoryAvg/ratingArtAvg/reviewCount +
  // an "overall" ratingAvg from Review rows in the service response; this
  // stays the seed-set starting point, not the live source of truth (the
  // existing `ratingAvg` column above stays the DR-2 catalog sort key —
  // the two may differ until PUB-3 reconciles them).
  creators       WorkCreator[]
  planches       Planche[]
  fundingGoals   FundingGoal[]
  reviews        Review[]

  // ── DR-4: reader "Lecteur" ────────────────────────────────────────────────
  favoritedBy     Favorite[] // DR-4 reads this list; DR-9 owns the toggle write + favoriteCount increment
  readingProgress ReadingProgress[]

  // ── DR-8: "Ma liste" saved works ─────────────────────────────────────────
  watchlistedBy WatchlistItem[]

  // ── DR-12: illustration collections (format 'Illustration(s)' Works) ──────
  collectionItems IllustrationCollection[] // ordered member illustrations of this collection
  contestId       String? // FK-by-convention link to Contest (validated in service; no Prisma relation)
  soutien         Json? // ponytail: raw Soutien config {tiers,allowDonations,revenueSplit}; MR-1/MR-2/CS-10 normalize into real tables

  // CS-1: back-relation for the Project↔Work bridge (a seeded Work belongs to at most one Project).
  project Project? // relation owner is Project.workId

  @@index([featuredRank])
  @@index([weeklyLikeDelta])
  @@index([likeCount])
  @@index([publishedAt])
  @@index([ratingAvg])
}

model Chapter {
  id           String        @id @default(cuid())
  workId       String
  work         Work          @relation(fields: [workId], references: [id])
  number       Int
  title        String?
  status       ChapterStatus @default(published)
  publishAt    DateTime      @default(now()) // future + status=scheduled → "Sorties programmées"
  createdAt    DateTime      @default(now())
  plancheCount Int           @default(0) // ponytail: denormalized; CS owns real page counts later
  likeCount    Int           @default(0) // ponytail: denormalized; DR-9 owns the increment

  // ── DR-4: reader "Lecteur" ────────────────────────────────────────────────
  premium         Boolean           @default(false) // locked flag; stands in for MR-1/MR-4 access tier
  prose           String? // roman chapter body; paragraphs separated by "\n\n"
  pages           Planche[] // reader pages (chapterId set); DR-3 work-level planches keep chapterId=null
  boardCards      Page[]            @relation("ChapterBoardCards") // CS-2 kanban cards attached to this chapter (distinct from `pages` above)
  readingProgress ReadingProgress[]

  @@index([status, publishAt])
  @@index([workId, number])
}

// ── DR-3: work page "Œuvre" (creative team, planches, funding goals, reviews) ──
// "CreatorMember" from the story's entity list is WorkCreator — a join row (Work × Account) with a
// per-work role/order, distinct from Profile.creatorRoles (DR-1, an account-level self-declared tag).

model WorkCreator {
  id        String  @id @default(cuid())
  workId    String
  work      Work    @relation(fields: [workId], references: [id])
  accountId String
  account   Account @relation(fields: [accountId], references: [id])
  role      String // "scenariste" | "dessinateur" | …
  order     Int     @default(0)

  @@unique([workId, accountId])
}

model Planche {
  id        String   @id @default(cuid())
  workId    String
  work      Work     @relation(fields: [workId], references: [id])
  chapterId String? // DR-4: set = reader page; null = DR-3 work-level grid planche
  chapter   Chapter? @relation(fields: [chapterId], references: [id])
  image     String?
  caption   String?
  order     Int      @default(0)

  @@index([workId, order])
  @@index([chapterId, order])
}

// ── DR-4: reader "Lecteur" (favorites switcher + reading progress) ───────────

model Favorite {
  id        String   @id @default(cuid())
  accountId String
  account   Account  @relation(fields: [accountId], references: [id])
  workId    String
  work      Work     @relation(fields: [workId], references: [id])
  createdAt DateTime @default(now())

  @@unique([accountId, workId])
  @@index([accountId])
}

model ReadingProgress {
  id        String   @id @default(cuid())
  accountId String
  account   Account  @relation(fields: [accountId], references: [id])
  chapterId String
  chapter   Chapter  @relation(fields: [chapterId], references: [id])
  workId    String
  work      Work     @relation(fields: [workId], references: [id])
  page      Int
  updatedAt DateTime @updatedAt

  @@unique([accountId, chapterId])
  @@index([accountId, updatedAt])
}

// ── DR-8: "Ma liste" saved works (watchlist) — read + remove only; DR-9 owns the add write ────

model WatchlistItem {
  id        String   @id @default(cuid())
  accountId String
  account   Account  @relation(fields: [accountId], references: [id])
  workId    String
  work      Work     @relation(fields: [workId], references: [id])
  createdAt DateTime @default(now())

  @@unique([accountId, workId])
  @@index([accountId, createdAt])
}

// ── DR-9: like/save toggles for targets with no per-user table (chapter, illustration) ────────
// Work reactions reuse Favorite (like) / WatchlistItem (save) — see list.service.ts / reactions.service.ts.

model Reaction {
  id         String   @id @default(cuid())
  accountId  String
  account    Account  @relation(fields: [accountId], references: [id])
  targetType String // 'chapter' | 'illustration'
  targetId   String // Chapter.id | Illustration.id
  kind       String // 'like' | 'save'
  createdAt  DateTime @default(now())

  @@unique([accountId, targetType, targetId, kind])
  @@index([targetType, targetId, kind])
}

model FundingGoal {
  id           String @id @default(cuid())
  workId       String
  work         Work   @relation(fields: [workId], references: [id])
  title        String
  currentCents Int    @default(0)
  targetCents  Int
  order        Int    @default(0)

  @@index([workId, order])
}

model Review {
  id          String   @id @default(cuid())
  workId      String
  work        Work     @relation(fields: [workId], references: [id])
  authorId    String? // nullable: seed fixtures have no real Account
  authorName  String
  storyRating Int
  artRating   Int
  text        String
  hidden      Boolean  @default(false) // AD-4/PUB-3 moderation flag; text blanked on the FE when true
  createdAt   DateTime @default(now())

  @@index([workId, createdAt])
}

// ── MC-10: block & mute ─────────────────────────────────────────────────────
enum BlockKind {
  block
  mute
}

model UserBlock {
  id        String    @id @default(cuid())
  blockerId String
  blockedId String
  kind      BlockKind
  createdAt DateTime  @default(now())
  blocker   Account   @relation("BlocksMade", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked   Account   @relation("BlocksReceived", fields: [blockedId], references: [id], onDelete: Cascade)

  @@unique([blockerId, blockedId, kind]) // also serves as the blockerId-direction index
  @@index([blockedId]) // reverse-direction lookups (enforcement checks)
}

model Announcement {
  id        String           @id @default(cuid())
  type      AnnouncementType
  label     String // French rich text, verbatim from prototype ribbon
  href      String // link target (future PUB-7/PUB-8 route)
  order     Int              @default(0)
  createdAt DateTime         @default(now())

  @@index([order])
}

// ── MC-1: project calls "Appels à projets" ────────────────────────────────────
// MC-1 ships only the read-preview (GET /calls). MC-4 owns POST, the full board, board
// filters/pagination, and any extra fields — do not add write logic here.
model ProjectCall {
  id               String    @id @default(cuid())
  title            String // "« Lames de Brume »"
  authorRoles      String[]  @default([]) // MC-4X §8: the author's creator role(s), snapshot of profile.creatorRoles (was single authorRole)
  seekingRoles     String[]  @default([]) // MC-4X req6: role(s) sought (1..2, = seats keys); kept for the board `has` filter
  seats            Json      @default("{}") // MC-4X §8: seat counts per sought role, e.g. { "dessinateur": 2, "scenariste": 1 }
  projectId        String? // MC-4X req6: optional link to an author-owned Project
  project          Project?  @relation(fields: [projectId], references: [id])
  authorId         String? // nullable, seed-friendly (mirror Illustration.artistId)
  authorName       String // denormalized display name
  tags             String[]  @default([]) // denormalized display chips (genre labels + scope/format)
  description      String    @default("") // MC-4: card body text
  genres           String[]  @default([]) // MC-4: GENRES ids (F-20) — used for board filtering
  format           String? // MC-4: 'serie' | 'one_shot'
  scope            String? // MC-4: free text, e.g. "~120 planches"
  closesAt         DateTime? // null → FE meta falls back to applicationCount; MC-4: the deadline
  applicationCount Int       @default(0)
  status           String    @default("open") // MC-4 owns transitions
  closedReason     String? // MC-14: 'full' (auto, reopenable) | 'manual' (owner close/deadline, sticky) | null while open
  createdAt        DateTime  @default(now())
  applications     Application[] // MC-5: applications submitted to this call
  assets           ProjectCallAsset[] // MC-4X: sample images + PDF documents (was single sampleMediaId)

  @@index([status, createdAt])
  @@index([authorId])
}

// MC-4X: a call's sample images (kind 'call_sample') and PDF documents (kind 'call_document'),
// ordered by position. Asset TYPE lives on Media.kind (no assetType column). Composite PK — no
// surrogate id. Backfill preserved every pre-MC-4X call's single sampleMediaId at position 0.
model ProjectCallAsset {
  callId   String
  mediaId  String
  position Int
  call     ProjectCall @relation(fields: [callId], references: [id], onDelete: Cascade)

  @@id([callId, mediaId])
  @@index([callId, position])
}

// ── MC-5: Candidater — apply to a call ────────────────────────────────────────

enum ApplicationStatus {
  pending
  accepted
  rejected
}

model Application {
  id                    String            @id @default(cuid())
  callId                String
  call                  ProjectCall       @relation(fields: [callId], references: [id], onDelete: Cascade)
  applicantId           String
  applicant             Account           @relation(fields: [applicantId], references: [id])
  sampleUrl             String // denormalized display URL of the FIRST sample — MC-6/MC-7 render this thumbnail
  message               String            @default("")
  status                ApplicationStatus @default(pending)
  appliedAs             String? // the CreatorRole the applicant applied AS (server-derived = call seekingRole); null on historical rows
  createdAt             DateTime          @default(now())
  assets                ApplicationAsset[] // MC-4X: 1..3 mixed samples (was single sampleMediaId/samplePortfolioItemId)

  @@unique([callId, applicantId]) // one application per user per call — DB-level backstop
  @@index([applicantId, createdAt]) // MC-6 "Mes candidatures" reads
}

// MC-4X: an application's samples (1..3), each an uploaded Media (image/PDF) XOR a PortfolioItem,
// ordered by position. Display info denormalized (url/kind/size) so reads need no join — mirrors the
// existing Application.sampleUrl denormalization. Backfill preserved the single sample at position 0.
model ApplicationAsset {
  applicationId   String
  application     Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  mediaId         String? // F-10 Media.id (kind 'application_sample' | 'application_document'), FK-by-convention
  portfolioItemId String? // F-3 PortfolioItem.id — FK-by-convention
  url             String // denormalized display URL (image thumb / portfolio image / document CDN url)
  kind            String // 'image' | 'document'
  size            Int? // bytes — documents only
  position        Int

  @@id([applicationId, position])
  @@index([applicationId])
}

// ── DR-2: catalog "Découvrir" (Contest banner + editor picks) ────────────────

model Contest {
  id        String    @id @default(cuid())
  category  String // e.g. "CONCOURS"
  title     String // "Prix du jeune mangaka 2026"
  subtitle  String // "Doté par un éditeur · clôture 30 j"
  ctaLabel  String // "Participer"
  href      String // PUB-7 route target (link/banner only for now)
  active    Boolean   @default(true)
  endsAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([active])
}

model EditorPick {
  id        String   @id @default(cuid())
  workId    String
  work      Work     @relation(fields: [workId], references: [id])
  blurb     String // "« Encre Blanche » repéré par une maison partenaire"
  order     Int      @default(0)
  createdAt DateTime @default(now())

  @@index([order])
}

// ── DR-5: illustration gallery "Galerie" ──────────────────────────────────────

model Illustration {
  id              String    @id @default(cuid())
  title           String
  artistId        String? // nullable like Review.authorId (seed fixtures may lack a real Account)
  artist          Account?  @relation(fields: [artistId], references: [id])
  artistName      String // denormalized display name (always present)
  category        String // GALLERY_CATEGORY_KEYS: personnages|couvertures|decors|fanart|process
  genres          String[]  @default([]) // Round 2: F-20 vocabulary fr labels (like Work.genre/themes) — genre[] facet
  image           String? // media URL; null -> CSS halftone placeholder (coverStyle)
  width           Int? // dimensions (DR-6/preview meta)
  height          Int?
  description     String? // DR-6: meta-block paragraph
  hashtags        String[]  @default([]) // DR-6: free descriptive chips ("#encre") — NOT F-20 genres
  tools           String? // DR-6: "Détails" -> Outils, e.g. "Encre · CSP"
  license         String? // DR-6: "Détails" -> Licence; null -> "© Tous droits réservés" (BE default)
  likeCount       Int       @default(0) // ponytail: denormalized; DR-9 owns the increment
  weeklyLikeDelta Int       @default(0) // rolling-7d delta -> "tendance" sort + trending endpoint
  publishedAt     DateTime? // null = not public; non-null = in gallery + "nouveautes" sort key
  createdAt       DateTime  @default(now())
  // CS-1 (induced): a standalone illustration is also contest-linkable + supportable.
  contestId       String? // FK-by-convention link to Contest (validated in service; no Prisma relation)
  soutien         Json? // ponytail: raw {tiers,allowDonations,goals}; goals folded in here (no workId) — MR-1/MR-2 normalize later

  collections IllustrationCollection[] // DR-12: collections (Illustration(s) Works) this piece belongs to

  @@index([publishedAt])
  @@index([weeklyLikeDelta])
  @@index([likeCount])
  @@index([category])
}

// ── DR-12: illustration collections (many-to-many, ordered per collection) ────
// A collection is a Work with format 'Illustration(s)'. This join carries the membership + per-
// collection ordering. Composite-unique on (illustrationId, workId) — dedup on re-add; both sides
// cascade-delete (deleting the collection Work or the Illustration removes the membership row).
model IllustrationCollection {
  illustrationId String
  illustration   Illustration @relation(fields: [illustrationId], references: [id], onDelete: Cascade)
  workId         String
  work           Work         @relation(fields: [workId], references: [id], onDelete: Cascade)
  order          Int          @default(0)

  @@id([illustrationId, workId])
  @@index([workId, order])
}

// ── F-21: support & contact tickets (help/contact/bug channel) ────────────────
// Submit is public (visitors + members). Reading/triage is AD-14's job — this model +
// the [status, createdAt] index make tickets staff-listable; no read endpoint ships here.

model SupportTicket {
  id        String   @id @default(cuid())
  category  String // allowlisted in DTO: general | account | bug | other
  accountId String? // nullable — visitors submit too
  account   Account? @relation(fields: [accountId], references: [id])
  name      String
  email     String
  message   String
  context   Json? // { url?, userAgent?, requestId? } for bug reports
  status    String   @default("new") // new | open | resolved (AD-14 owns transitions)
  createdAt DateTime @default(now())

  @@index([accountId])
  @@index([status, createdAt]) // AD-14 staff triage listing
}

// ── CS-2: project workspace kanban (Espace projet) ───────────────────────────
// `Page` is a KANBAN BOARD CARD (script→validated art tracking), NOT `Planche`
// (the published reader page). Distinct concept, distinct table on purpose.

enum PageStage {
  scenario
  nemu
  corrections
  propre
  encrage
  valide
}

model Page {
  id            String        @id @default(cuid())
  projectId     String
  project       Project       @relation(fields: [projectId], references: [id])
  chapterId     String? // null = card not yet attached to a chapter
  chapter       Chapter?      @relation("ChapterBoardCards", fields: [chapterId], references: [id])
  title         String // card label, e.g. "Page 7"
  stage         PageStage     @default(scenario)
  version       Int           @default(1)
  fileTags      String[]      @default([]) // PAGE_FILE_TAGS subset: scenario|ref|nemu|double
  linkedFileIds String[]      @default([]) // CS-3 Asset/Media ids — stored, not resolved here
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  versions      PageVersion[]

  @@index([projectId, chapterId, stage])
}

model PageVersion {
  id        String   @id @default(cuid())
  pageId    String
  page      Page     @relation(fields: [pageId], references: [id], onDelete: Cascade)
  version   Int
  note      String?
  createdAt DateTime @default(now())

  @@index([pageId, version])
}
