// F-1: account sign-up & login. F-3 extends Profile. F-5 adds Notification. F-10 adds Media.
// F-11 adds EmailVerificationToken. F-12 adds PasswordResetToken. F-13 adds LegalDocument + ConsentRecord.
// F-14 adds DataExport + Account.deletedAt + NotifType.system.
// F-15 adds NotificationPreference. F-17 adds Account.onboardedAt + Profile.creatorRoles.
// F-18 adds TwoFactorCredential + EmailChangeToken.
// DR-1 adds Work, Chapter, Announcement + Profile.trendingScore (home showroom).
// DR-3 extends Work/Chapter + adds WorkCreator, Planche, FundingGoal, Review (work page "Œuvre").
// DR-4 extends Chapter (premium/prose) + Planche (chapterId) + adds Favorite, ReadingProgress (reader).
// MC-8 adds Connection + ConnectionStatus + NotifType.connection_* (contacts & connexions network).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // Runtime traffic goes through PgBouncer (transaction pooling). The URL carries `pgbouncer=true`,
  // which makes Prisma stop using prepared statements — transaction mode cannot share them between
  // clients, and without the flag you get sporadic "prepared statement s0 already exists" errors.
  url       = env("DATABASE_URL")
  // Prisma Migrate MUST bypass the pooler: DDL and advisory locks need one stable session, which
  // transaction pooling does not provide. Points straight at Postgres:5433.
  directUrl = env("DIRECT_DATABASE_URL")
}

enum Role {
  utilisateur
  maintainer
  editor
  admin
}

enum NotifType {
  message
  application
  report
  invitation
  project_activity
  release
  like
  comment
  system // F-14: system notifications (data export ready, etc.)
  application_accepted // MC-7: owner accepted an applicant
  application_rejected // MC-7: owner rejected an applicant
  connection_request // MC-8: someone sent a connection request
  connection_accepted // MC-8: the recipient accepted the connection request
  group_removed // MC-12: the group creator removed you from a group
  mention // CS-2: mentioned via @name in a card comment
}

// ── DR-1 Work/Chapter/Announcement enums ───────────────────────────────────────

enum ChapterStatus {
  draft
  scheduled
  published
}

enum AnnouncementType {
  concours
  a_chaud
  evenement
}

// ── F-14 DataExport enum ──────────────────────────────────────────────────────

enum DataExportStatus {
  pending
  ready
  failed
  expired
}

// ── F-10 Media enums ──────────────────────────────────────────────────────────

enum MediaKind {
  avatar
  cover
  portfolio
  chapter_page
  illustration
  attachment
  article
  contest
  call_sample
  application_sample
  call_document
  application_document
  asset
}

enum MediaStatus {
  pending
  ready
  failed
}

enum MediaVisibility {
  public
  private
}

// ── F-13 Legal enums ──────────────────────────────────────────────────────────

enum LegalKind {
  cgu
  privacy
  mentions
  charte // Charte de la communauté — integral part of the CGU, served at /charte
}

enum ConsentDocument {
  cgu
  privacy
}

model Account {
  id                         String                    @id @default(uuid(7)) @db.Uuid
  displayName                String
  email                      String                    @unique
  passwordHash               String
  role                       Role                      @default(utilisateur)
  verified                   Boolean                   @default(false) // ponytail: flat flag; AD-3 sets it, no separate Editor table
  profileSlug                String                    @unique
  avatar                     String?
  preferences                Json                      @default("{\"theme\":\"system\"}") // F-6: extensible JSON; promote to sub-model if preferences multiply
  createdAt                  DateTime                  @default(now())
  emailVerifiedAt            DateTime? // F-11: null = unverified; set on confirmation
  birthdate                  DateTime?                 @db.Date // DR-10: RGPD PII, never public; null = not yet declared (prompt on next 18+ access)
  deletedAt                  DateTime? // F-14: null = active; non-null = tombstoned (RGPD erasure)
  onboardedAt                DateTime? // F-17: null = show onboarding wizard; set on completion/skip
  profile                    Profile?
  notificationsReceived      Notification[]            @relation("NotifRecipient")
  notificationsSent          Notification[]            @relation("NotifSource")
  notificationPreferences    NotificationPreference[]
  media                      Media[]
  emailVerificationTokens    EmailVerificationToken[]
  passwordResetTokens        PasswordResetToken[]
  consents                   ConsentRecord[] // F-13: append-only acceptance log
  dataExports                DataExport[] // F-14: export requests
  twoFactor                  TwoFactorCredential? // F-18: TOTP credential (optional; 1-to-1)
  emailChangeTokens          EmailChangeToken[] // F-18: pending email-change requests
  workCredits                WorkCreator[] // DR-3: works this account is credited on
  favorites                  Favorite[] // DR-4: favorited works (reads only; DR-9 owns the toggle write)
  readingProgress            ReadingProgress[] // DR-4: per-chapter reading position (feeds DR-8)
  illustrations              Illustration[] // DR-5: gallery illustrations credited to this artist
  watchlist                  WatchlistItem[] // DR-8: saved "Ma liste" works (reads + remove only; DR-9 owns the add)
  reactions                  Reaction[] // DR-9: chapter/illustration like+save toggles (works reuse Favorite/WatchlistItem)
  supportTickets             SupportTicket[] // F-21: help/contact/bug tickets submitted while signed in
  projects                   Project[]                 @relation("ProjectOwner") // CS-1 seam: projects this account owns
  invitationsSent            Invitation[]              @relation("InvitationsSent") // MC-3: collab invites sent
  invitationsReceived        Invitation[]              @relation("InvitationsReceived") // MC-3: collab invites received
  applications               Application[] // MC-5: call applications this account submitted
  connectionsSent            Connection[]              @relation("ConnectionsSent") // MC-8: requests this account initiated
  connectionsReceived        Connection[]              @relation("ConnectionsReceived") // MC-8: requests addressed to this account
  conversationParticipations ConversationParticipant[] // MC-9: conversations this account is a member of
  messagesSent               Message[]                 @relation("MessagesSent") // MC-9: messages this account sent
  messageLikes               MessageLike[] // MC-15: messages this account liked
  blocksMade                 UserBlock[]               @relation("BlocksMade") // MC-10: block/mute rows this account created
  blocksReceived             UserBlock[]               @relation("BlocksReceived") // MC-10: rows where this account is the target
  pageAssignments            PageAssignee[]            @relation("PageAssignee") // CS-2: kanban cards this account is assigned to
  pagesCreated               Page[]                    @relation("PageAuthor") // CS-10: kanban cards this account created (delete gate)
  pageComments               PageComment[]             @relation("PageCommentAuthor") // CS-2: card comments this account authored
  assetVersions              AssetVersion[]            @relation("AssetVersionAuthor") // CS-3: asset versions this account uploaded
  scenarioComments           ScenarioComment[]         @relation("ScenarioCommentAuthor") // CS-4: per-case comments this account authored
  corrections                Correction[]              @relation("CorrectionAuthor") // CS-5: review corrections this account filed

  // Seed-coherence pass: catalog search-by-author-name matches WorkCreator -> Account.displayName.
  @@index([displayName])
}

// ── F-10 Media model ──────────────────────────────────────────────────────────

model Media {
  id          String          @id @default(uuid(7)) @db.Uuid
  ownerId     String          @db.Uuid
  owner       Account         @relation(fields: [ownerId], references: [id])
  kind        MediaKind
  bucketKey   String
  contentType String
  size        Int
  width       Int?
  height      Int?
  status      MediaStatus     @default(pending)
  variants    Json            @default("{}")
  visibility  MediaVisibility @default(public)
  createdAt   DateTime        @default(now())
  dataExport  DataExport? // F-14: back-relation (one archive per export)

  @@index([ownerId])
  @@index([status, createdAt])
}

// ── F-14: DataExport ──────────────────────────────────────────────────────────

model DataExport {
  id          String           @id @default(uuid(7)) @db.Uuid
  accountId   String           @db.Uuid
  account     Account          @relation(fields: [accountId], references: [id])
  status      DataExportStatus @default(pending)
  mediaId     String?          @unique @db.Uuid
  media       Media?           @relation(fields: [mediaId], references: [id])
  requestedAt DateTime         @default(now())
  readyAt     DateTime?
  expiresAt   DateTime?

  @@index([accountId, status])
  @@index([status, expiresAt]) // purge sweep
}

model Profile {
  id                   String          @id @default(uuid(7)) @db.Uuid
  accountId            String          @unique @db.Uuid
  account              Account         @relation(fields: [accountId], references: [id])
  coverImage           String?
  specialty            String?
  city                 String?
  bio                  String?
  creatorRoles         String[]        @default([]) // F-17: onboarding Step 1 sub-roles (NOT authz role)
  seekingActive        Boolean         @default(false)
  seekingTargetRole    String?
  seekingGenres        String[]        @default([])
  seekingProjectLength String?
  tags                 String[]        @default([])
  portfolio            PortfolioItem[]
  trendingScore        Int             @default(0) // DR-1: denormalized "of the moment" rank; engagement pipeline recomputes later
  country              String? // MC-1: ISO 3166-1 alpha-2 — directory location unit ('Hors France' bucket retired)
  region               String? // MC-1: FR-only sub-level (one of PARTNER_REGIONS, only when country = 'FR')
  availability         String          @default("ouvert") // MC-1: PARTNER_AVAILABILITY_KEYS — "Dispo" filter
  createdAt            DateTime        @default(now())

  @@index([trendingScore])
  @@index([country]) // MC-1: directory location filter (continent/country tokens)
  @@index([region]) // MC-1: FR-région sub-filter (creatorRoles is an array — GIN not expressible in Prisma, skip at this scale)
}

model PortfolioItem {
  id        String   @id @default(uuid(7)) @db.Uuid
  profileId String   @db.Uuid
  profile   Profile  @relation(fields: [profileId], references: [id])
  image     String
  caption   String?
  order     Int      @default(0)
  createdAt DateTime @default(now())
  // DB pass 2026-08-02: every FK needs its own index. RESTRICT, SET NULL and CASCADE
  // all make Postgres look up child rows when a parent is deleted — unindexed that is a
  // sequential scan, and F-14 account erasure / CS-16 project delete hit exactly these.
  @@index([profileId])
}

// ── F-11: Email verification token ───────────────────────────────────────────

model EmailVerificationToken {
  id         String    @id @default(uuid(7)) @db.Uuid
  accountId  String    @db.Uuid
  account    Account   @relation(fields: [accountId], references: [id])
  tokenHash  String    @unique // sha256(raw); raw is never stored
  expiresAt  DateTime // createdAt + 24h
  consumedAt DateTime? // single-use: non-null once confirmed
  createdAt  DateTime  @default(now())

  @@index([accountId])
}

// ── F-12: Password reset token (mirrors F-11 EmailVerificationToken; TTL 1h) ──

model PasswordResetToken {
  id         String    @id @default(uuid(7)) @db.Uuid
  accountId  String    @db.Uuid
  account    Account   @relation(fields: [accountId], references: [id])
  tokenHash  String    @unique // sha256(raw); raw is never stored
  expiresAt  DateTime // createdAt + 1h
  consumedAt DateTime? // single-use: non-null once used
  createdAt  DateTime  @default(now())

  @@index([accountId])
}

model Notification {
  id           String    @id @default(uuid(7)) @db.Uuid
  recipientId  String    @db.Uuid
  recipient    Account   @relation("NotifRecipient", fields: [recipientId], references: [id])
  type         NotifType
  refId        String?   @db.Uuid
  message      String? // CS-2: per-notification copy override (else FE resolves from the type map)
  sourceUserId String?   @db.Uuid
  sourceUser   Account?  @relation("NotifSource", fields: [sourceUserId], references: [id])
  createdAt    DateTime  @default(now())
  readAt       DateTime?

  @@index([recipientId, readAt])
  @@index([recipientId, createdAt])
  // DB pass 2026-08-02: every FK needs its own index. RESTRICT, SET NULL and CASCADE
  // all make Postgres look up child rows when a parent is deleted — unindexed that is a
  // sequential scan, and F-14 account erasure / CS-16 project delete hit exactly these.
  @@index([sourceUserId])
}

// ── MC-3: Collaboration invitations + CS-1 project seam ───────────────────────

enum InvitationStatus {
  pending
  accepted
  declined
}

// CS-1 seam: minimal project shell so MC-3's picker + ownership validation work.
// CS-1 owns creation/workspace and extends this model (never renames these fields).
model Project {
  id            String         @id @default(uuid(7)) @db.Uuid
  ownerId       String         @db.Uuid
  owner         Account        @relation("ProjectOwner", fields: [ownerId], references: [id])
  title         String
  kind          String         @default("Manga") // "Manga" | "Illustration(s)" | … (picker meta line)
  genre         String? // fr label, e.g. "Seinen" (picker meta line)
  status        String         @default("en cours") // "en cours" | "en révision" | … (picker meta line)
  cover         String? // image URL; null -> halftone placeholder
  slug          String?        @unique // CS-2 workspace address (GET /projects/{slug}); nullable so legacy rows survive
  step          String? // CS-12 dashboard: current production step, e.g. "encrage Ch.1" — CS-2/CS-5 own writing it
  nextReleaseAt DateTime? // CS-12 dashboard: next scheduled release — CS-9 owns writing it
  // CS-1: the Project↔Work bridge. `workId` shares the Project's slug value, so /projet/{slug} and
  // /oeuvre/{slug} resolve to the same pair. REQUIRED since the CS-7 follow-up: a Work-less Project
  // is the seed defect behind « Projet introuvable », now unrepresentable rather than merely guarded.
  visibility    String         @default("prive") // 'prive' | 'invitation' | 'public' (workspace/collab)
  collabOpen    Boolean        @default(false) // CS-2 "Demandes de collaboration" toggle (distinct from visibility; MC candidature reads it)
  workId        String         @unique @db.Uuid // seeded œuvre (Work) — created in one $transaction with the Project
  work          Work           @relation(fields: [workId], references: [id])
  createdAt     DateTime       @default(now())
  invitations   Invitation[]
  calls         ProjectCall[] // MC-4X req6: calls linked to this project
  pages         Page[] // CS-2 kanban board cards (NOT Planche — see Page model)
  labels        ProjectLabel[] // CS-2 card-modal: user-created label palette
  assets        Asset[] // CS-3 imported files (versioned)

  @@index([ownerId])
}

model Invitation {
  id          String           @id @default(uuid(7)) @db.Uuid
  fromUserId  String           @db.Uuid
  fromUser    Account          @relation("InvitationsSent", fields: [fromUserId], references: [id])
  toUserId    String           @db.Uuid
  toUser      Account          @relation("InvitationsReceived", fields: [toUserId], references: [id])
  projectId   String?          @db.Uuid
  project     Project?         @relation(fields: [projectId], references: [id])
  message     String           @default("")
  status      InvitationStatus @default(pending)
  createdAt   DateTime         @default(now())
  respondedAt DateTime?

  @@index([fromUserId, status])
  @@index([toUserId, status])
  // DB pass 2026-08-02: every FK needs its own index. RESTRICT, SET NULL and CASCADE
  // all make Postgres look up child rows when a parent is deleted — unindexed that is a
  // sequential scan, and F-14 account erasure / CS-16 project delete hit exactly these.
  @@index([projectId])
}

// ── MC-8: Contacts & connexions ───────────────────────────────────────────────

enum ConnectionStatus {
  pending
  accepted
  declined
}

// MC-8: one row per user pair. A `pending` row IS the story's ConnectionRequest; an `accepted` row
// IS the mutual Connection. Direction (requester→addressee) matters only while pending.
model Connection {
  id          String           @id @default(uuid(7)) @db.Uuid
  requesterId String           @db.Uuid
  requester   Account          @relation("ConnectionsSent", fields: [requesterId], references: [id])
  addresseeId String           @db.Uuid
  addressee   Account          @relation("ConnectionsReceived", fields: [addresseeId], references: [id])
  status      ConnectionStatus @default(pending)
  context     String           @default("") // D6: derived French context line, frozen at creation
  createdAt   DateTime         @default(now())
  respondedAt DateTime?

  @@unique([requesterId, addresseeId]) // backstop; service enforces one row per unordered pair
  @@index([addresseeId, status])
  @@index([requesterId, status])
}

// ── MC-9: Messaging (floating widget) ─────────────────────────────────────────
// readBy[] is DERIVED, not stored: message M is read by participant P iff
// P.lastReadAt >= M.createdAt. One timestamp per participant (O(1) mark-read) instead of a
// row per (message × reader). Unread per conversation = messages after my lastReadAt not sent by me.

enum ConversationType {
  dm
  group
  salon // MC-11: one global public room "Le Comptoir"
}

model Conversation {
  id            String                    @id @default(uuid(7)) @db.Uuid
  type          ConversationType
  name          String? // group only; DM title is computed per-viewer (the OTHER party)
  projectId     String?                   @db.Uuid // CS-8 seam: a project group chat IS this conversation
  // dm only: "minId:maxId" — DB backstop, one DM per pair. Stays `text`: it is a COMPOSITE of two
  // uuids joined by ':' (73 chars now, was 51 with cuids), not an id, so `uuid` cannot hold it.
  dmKey         String?                   @unique
  status        String                    @default("open") // 'open' | 'requested' | 'declined' — DM request lifecycle; groups/salon always 'open'
  requestedBy   String?                   @db.Uuid // accountId of the requester while status != 'open'
  createdBy     String?                   @db.Uuid // MC-12: group owner accountId; null for dm/salon (every group has one)
  createdAt     DateTime                  @default(now())
  lastMessageAt DateTime                  @default(now()) // list ordering key (bumped on each send)
  participants  ConversationParticipant[]
  messages      Message[]

  // CS-8: ONE thread per project, made unrepresentable rather than app-enforced (two members opening
  // the Discussion tab at once cannot create two). NULL repeats freely, so DMs/salon are unaffected.
  @@unique([projectId])
  @@index([lastMessageAt])
}

model ConversationParticipant {
  conversationId String       @db.Uuid
  accountId      String       @db.Uuid
  lastReadAt     DateTime     @default(now()) // unread = messages after this, not sent by me
  createdAt      DateTime     @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  account        Account      @relation(fields: [accountId], references: [id])

  @@id([conversationId, accountId])
  @@index([accountId])
}

model Message {
  id             String       @id @default(uuid(7)) @db.Uuid
  conversationId String       @db.Uuid
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String       @db.Uuid
  sender         Account      @relation("MessagesSent", fields: [senderId], references: [id])
  body           String       @default("")
  attachments    Json         @default("[]") // MessageAttachment[] denormalized display (mediaId,name,kind)
  attachmentIds  String[]     @default([]) @db.Uuid // Media.ids — queryable authz lookup for signed-URL gating (F-10)
  createdAt      DateTime     @default(now())

  // MC-15 — a reply is a QUOTE, not a branch: one nullable pointer, no thread tree.
  replyToId      String?       @db.Uuid
  replyTo        Message?      @relation("MessageReply", fields: [replyToId], references: [id], onDelete: SetNull)
  replies        Message[]     @relation("MessageReply")
  /// D-3: `SetNull` erases the FACT that this message quoted something, which would make
  /// « Message supprimé » unrepresentable. The delete path flips this flag on the children in the
  /// same transaction, so a reply whose target is gone still renders its quote.
  replyToDeleted Boolean       @default(false)
  editedAt       DateTime? // MC-15: non-null ⇒ the bubble shows « modifié »
  likes          MessageLike[]

  @@index([conversationId, createdAt])
  @@index([replyToId])
  // DB pass 2026-08-02: every FK needs its own index. RESTRICT, SET NULL and CASCADE
  // all make Postgres look up child rows when a parent is deleted — unindexed that is a
  // sequential scan, and F-14 account erasure / CS-16 project delete hit exactly these.
  @@index([senderId])
}

/// MC-15 — one like per person per message: the composite PK makes a double like unrepresentable
/// rather than app-enforced (same reasoning as CS-6's cover column, CS-8's @@unique([projectId])).
model MessageLike {
  messageId String   @db.Uuid
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  accountId String   @db.Uuid
  account   Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([messageId, accountId])
  @@index([accountId])
}

// ── F-13: Legal documents & consent records ───────────────────────────────────

// ── F-15: Notification & e-mail preferences ──────────────────────────────────

model NotificationPreference {
  id        String  @id @default(uuid(7)) @db.Uuid
  accountId String  @db.Uuid
  account   Account @relation(fields: [accountId], references: [id])
  type      String // NotificationPrefType (string — forward-compatible with new categories)
  channel   String // 'in_app' | 'email'
  enabled   Boolean

  @@unique([accountId, type, channel])
  @@index([accountId])
}

model LegalDocument {
  id          String    @id @default(uuid(7)) @db.Uuid
  kind        LegalKind
  version     String
  content     String // trusted HTML
  publishedAt DateTime  @default(now())

  @@unique([kind, version])
  @@index([kind, publishedAt])
}

model ConsentRecord {
  id         String          @id @default(uuid(7)) @db.Uuid
  accountId  String          @db.Uuid
  account    Account         @relation(fields: [accountId], references: [id])
  document   ConsentDocument
  version    String
  acceptedAt DateTime        @default(now())
  ip         String?

  @@index([accountId, document])
}

// ── F-18: 2FA credential (one per account; enabledAt null = pending/unconfirmed) ──

model TwoFactorCredential {
  id               String    @id @default(uuid(7)) @db.Uuid
  accountId        String    @unique @db.Uuid // one credential per account
  account          Account   @relation(fields: [accountId], references: [id])
  secretEncrypted  String // AES-256-GCM "iv:tag:ciphertext" (base64); never logged
  enabledAt        DateTime? // null = setup pending (secret issued, not confirmed)
  backupCodeHashes String[]  @default([]) // sha256(code) hex; single-use → removed on use
  createdAt        DateTime  @default(now())
}

// ── F-18: Email change token (mirrors F-11 EmailVerificationToken) ────────────

model EmailChangeToken {
  id         String    @id @default(uuid(7)) @db.Uuid
  accountId  String    @db.Uuid
  account    Account   @relation(fields: [accountId], references: [id])
  newEmail   String // committed to Account.email on confirm
  tokenHash  String    @unique // sha256(raw); raw never stored (mirror F-11/F-12)
  expiresAt  DateTime // createdAt + 24h
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([accountId])
}

// ── DR-1: home showroom (Work/Chapter/Announcement) ───────────────────────────
// "ScheduledRelease" and "Creator" from the story's entity list are NOT separate tables:
// a scheduled release IS a Chapter with status=scheduled + publishAt>now; a creator IS an
// existing Account+Profile (role via Profile.creatorRoles, see trendingScore above).

model Work {
  id                 String    @id @default(uuid(7)) @db.Uuid
  slug               String    @unique
  title              String
  coverImage         String? // media URL; null → CSS halftone placeholder on FE
  genre              String // display fr label — "Shōnen" | "Seinen" | "Fantastique" | "Josei" | …
  // (DR-2 catalog GENRE facet accepts F-20 vocabulary ids in the
  // query and maps id→fr via catalogGenreLabel() before filtering
  // this column — see catalog.service.ts. Column itself is unchanged
  // from DR-1: kept as the fr display label, reused verbatim by cards.)
  // (the `meta` String column was DROPPED 2026-08-02 — the hero/ranking line is derived from
  //  `creators` + `chapterCount` by shared `workMetaLine()`; see api/src/works/work-meta.ts)
  likeCount          Int       @default(0) // ponytail: denormalized total; DR-9 owns the increment
  weeklyLikeDelta    Int       @default(0) // ponytail: rolling-7d delta; DR-9/DR-4 recompute from events
  priorWeekLikeDelta Int       @default(0) // ponytail: prior-period delta for growth %; same note
  featuredRank       Int? // null = not in "À LA UNE"; else carousel order asc
  createdAt          DateTime  @default(now())
  chapters           Chapter[]

  // ── DR-2: catalog facet columns ──────────────────────────────────────────
  themes         String[]     @default([]) // CATALOG_THEMES subset (OR-in filter)
  format         String       @default("Manga") // one of CATALOG_FORMATS
  language       String       @default("Français") // one of CATALOG_LANGUAGES
  audienceRating String       @default("Tous publics") // CATALOG_AUDIENCE_RATINGS — DR-10 reads this for 18+ gating
  complete       Boolean      @default(false) // STATUT: true = "Œuvres complètes"
  chapterCount   Int          @default(0) // published-chapter counter — kept denormalized ON PURPOSE: Prisma cannot
  // filter or sort on a relation count and DR-2's LONGUEUR facet does exactly
  // that. It has ONE writer, `syncWorkChapterCount()` (works/chapter-count.ts),
  // called from every chapter create/delete; never hand-set it.
  ratingAvg      Float        @default(0) // ponytail: denormalized; PUB-3 reviews own it
  publishedAt    DateTime? // null = not in catalog; non-null = published + recency sort key
  editorPicks    EditorPick[]

  // ── DR-3: work page "Œuvre" columns ──────────────────────────────────────
  synopsis       String? // "Synopsis" block body
  hashtags       String[]      @default([]) // "#..." chips under the synopsis
  proseExcerpt   String? // roman-only excerpt body; response nulls it unless format==='Roman'
  readCount      Int           @default(0) // ponytail: denormalized; DR-4 owns the increment (reader open)
  favoriteCount  Int           @default(0) // ponytail: denormalized; DR-9 owns the increment
  ratingStoryAvg Float         @default(0) // ponytail: recomputed from Review rows in WorksService (not stored authoritative)
  ratingArtAvg   Float         @default(0) // same note
  reviewCount    Int           @default(0) // same note — DR-3 recomputes ratingStoryAvg/ratingArtAvg/reviewCount +
  // an "overall" ratingAvg from Review rows in the service response; this
  // stays the seed-set starting point, not the live source of truth (the
  // existing `ratingAvg` column above stays the DR-2 catalog sort key —
  // the two may differ until PUB-3 reconciles them).
  creators       WorkCreator[]
  planches       Planche[]
  fundingGoals   FundingGoal[]
  reviews        Review[]

  // ── DR-4: reader "Lecteur" ────────────────────────────────────────────────
  favoritedBy     Favorite[] // DR-4 reads this list; DR-9 owns the toggle write + favoriteCount increment
  readingProgress ReadingProgress[]

  // ── DR-8: "Ma liste" saved works ─────────────────────────────────────────
  watchlistedBy WatchlistItem[]

  // ── DR-12: illustration collections (format 'Illustration(s)' Works) ──────
  collectionItems IllustrationCollection[] // ordered member illustrations of this collection
  contestId       String?                  @db.Uuid // FK-by-convention link to Contest (validated in service; no Prisma relation)
  soutien         Json? // ponytail: raw Soutien config {tiers,allowDonations,revenueSplit}; MR-1/MR-2/CS-10 normalize into real tables

  // CS-1: back-relation for the Project↔Work bridge (a seeded Work belongs to at most one Project).
  project Project? // relation owner is Project.workId

  @@index([featuredRank])
  @@index([weeklyLikeDelta])
  @@index([likeCount])
  @@index([publishedAt])
  @@index([ratingAvg])
}

model Chapter {
  id           String        @id @default(uuid(7)) @db.Uuid
  workId       String        @db.Uuid
  work         Work          @relation(fields: [workId], references: [id])
  number       Int
  title        String?
  status       ChapterStatus @default(published)
  resume       String? // CS-7 — chapter summary shown in the Chapitres tab's inline edit form
  // CS-7 R2-7 — « PLANCHES PRÉVUES »: the chapter's planned length, the DENOMINATOR of the progress
  // pill (done ÷ prévues). R3-2 made it NOT NULL with a default of 20 (a standard chapter length):
  // the bar is always displayed, so "no target" — and with it the null percentage — no longer exists.
  targetPages  Int           @default(20)
  // CS-6 — does this chapter OPEN on a cover? A toggle, not a designation: the cover is always the
  // first page (`effectiveCoverPageId`), this only says whether that page is one. A hand-picked
  // cover image belongs to the PROJECT (`Project.cover`), never to a chapter (user, 2026-08-01).
  // Consequence in the reader: a cover never pairs into a 2-page spread, it stands alone.
  hasCover     Boolean       @default(true)
  publishAt    DateTime      @default(now()) // future + status=scheduled → "Sorties programmées"
  createdAt    DateTime      @default(now())
  plancheCount Int           @default(0) // ponytail: denormalized; CS owns real page counts later
  likeCount    Int           @default(0) // ponytail: denormalized; DR-9 owns the increment

  // ── DR-4: reader "Lecteur" ────────────────────────────────────────────────
  premium         Boolean           @default(false) // locked flag; stands in for MR-1/MR-4 access tier
  prose           String? // roman chapter body; paragraphs separated by "\n\n"
  pages           Planche[] // reader pages (chapterId set); DR-3 work-level planches keep chapterId=null
  boardCards      Page[]            @relation("ChapterBoardCards") // CS-2 kanban cards attached to this chapter (distinct from `pages` above)
  readingProgress ReadingProgress[]

  // CS-7 B5: chapter numbers are unique per project. `Project.workId` is 1:1, so work-scoped
  // uniqueness IS project-scoped uniqueness. Replaces the plain @@index (a unique index serves
  // the same lookups).
  @@unique([workId, number])
  @@index([status, publishAt])
}

// ── DR-3: work page "Œuvre" (creative team, planches, funding goals, reviews) ──
// "CreatorMember" from the story's entity list is WorkCreator — a join row (Work × Account) with a
// per-work role/order, distinct from Profile.creatorRoles (DR-1, an account-level self-declared tag).

model WorkCreator {
  id        String  @id @default(uuid(7)) @db.Uuid
  workId    String  @db.Uuid
  work      Work    @relation(fields: [workId], references: [id])
  accountId String  @db.Uuid
  account   Account @relation(fields: [accountId], references: [id])
  role      String // "scenariste" | "dessinateur" | …
  order     Int     @default(0)

  // CS-10 — group model lives on the membership row (no parallel Member model).
  groupRole   String   @default("member") // 'leader' | 'coleader' | 'member'
  permissions String[] @default(["ecriture", "corrections"]) // stored toggles; leadership implies all
  sharePct    Int      @default(0) // revenue split %, group invariant: sum = 100

  @@unique([workId, accountId])
  // DB pass 2026-08-02: every FK needs its own index. RESTRICT, SET NULL and CASCADE
  // all make Postgres look up child rows when a parent is deleted — unindexed that is a
  // sequential scan, and F-14 account erasure / CS-16 project delete hit exactly these.
  @@index([accountId])
}

model Planche {
  id        String   @id @default(uuid(7)) @db.Uuid
  workId    String   @db.Uuid
  work      Work     @relation(fields: [workId], references: [id])
  chapterId String?  @db.Uuid // DR-4: set = reader page; null = DR-3 work-level grid planche
  chapter   Chapter? @relation(fields: [chapterId], references: [id])
  image     String?
  caption   String?
  order     Int      @default(0)

  @@index([workId, order])
  @@index([chapterId, order])
}

// ── DR-4: reader "Lecteur" (favorites switcher + reading progress) ───────────

