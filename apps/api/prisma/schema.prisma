// F-1: account sign-up & login. F-3 extends Profile. F-5 adds Notification. F-10 adds Media.
// F-11 adds EmailVerificationToken. F-12 adds PasswordResetToken. F-13 adds LegalDocument + ConsentRecord.
// F-14 adds DataExport + Account.deletedAt + NotifType.system.
// F-15 adds NotificationPreference. F-17 adds Account.onboardedAt + Profile.creatorRoles.
// F-18 adds TwoFactorCredential + EmailChangeToken.
// DR-1 adds Work, Chapter, Announcement + Profile.trendingScore (home showroom).
// DR-3 extends Work/Chapter + adds WorkCreator, Planche, FundingGoal, Review (work page "Œuvre").
// DR-4 extends Chapter (premium/prose) + Planche (chapterId) + adds Favorite, ReadingProgress (reader).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  utilisateur
  maintainer
  editor
  admin
}

enum NotifType {
  message
  application
  report
  invitation
  project_activity
  release
  like
  comment
  system // F-14: system notifications (data export ready, etc.)
}

// ── DR-1 Work/Chapter/Announcement enums ───────────────────────────────────────

enum ChapterStatus {
  draft
  scheduled
  published
}

enum AnnouncementType {
  concours
  a_chaud
  evenement
}

// ── F-14 DataExport enum ──────────────────────────────────────────────────────

enum DataExportStatus {
  pending
  ready
  failed
  expired
}

// ── F-10 Media enums ──────────────────────────────────────────────────────────

enum MediaKind {
  avatar
  cover
  portfolio
  chapter_page
  illustration
  attachment
  article
  contest
}

enum MediaStatus {
  pending
  ready
  failed
}

enum MediaVisibility {
  public
  private
}

// ── F-13 Legal enums ──────────────────────────────────────────────────────────

enum LegalKind {
  cgu
  privacy
  mentions
}

enum ConsentDocument {
  cgu
  privacy
}

model Account {
  id                       String                   @id @default(cuid())
  displayName              String
  email                    String                   @unique
  passwordHash             String
  role                     Role                     @default(utilisateur)
  verified                 Boolean                  @default(false) // ponytail: flat flag; AD-3 sets it, no separate Editor table
  profileSlug              String                   @unique
  avatar                   String?
  preferences              Json                     @default("{\"theme\":\"system\"}") // F-6: extensible JSON; promote to sub-model if preferences multiply
  createdAt                DateTime                 @default(now())
  emailVerifiedAt          DateTime?                // F-11: null = unverified; set on confirmation
  deletedAt                DateTime?                // F-14: null = active; non-null = tombstoned (RGPD erasure)
  onboardedAt              DateTime?                // F-17: null = show onboarding wizard; set on completion/skip
  profile                  Profile?
  notificationsReceived    Notification[]           @relation("NotifRecipient")
  notificationsSent        Notification[]           @relation("NotifSource")
  notificationPreferences  NotificationPreference[]
  media                    Media[]
  emailVerificationTokens  EmailVerificationToken[]
  passwordResetTokens      PasswordResetToken[]
  consents                 ConsentRecord[]          // F-13: append-only acceptance log
  dataExports              DataExport[]             // F-14: export requests
  twoFactor                TwoFactorCredential?     // F-18: TOTP credential (optional; 1-to-1)
  emailChangeTokens        EmailChangeToken[]       // F-18: pending email-change requests
  workCredits              WorkCreator[]            // DR-3: works this account is credited on
  favorites                Favorite[]               // DR-4: favorited works (reads only; DR-9 owns the toggle write)
  readingProgress          ReadingProgress[]        // DR-4: per-chapter reading position (feeds DR-8)
  illustrations            Illustration[]           // DR-5: gallery illustrations credited to this artist
  watchlist                WatchlistItem[]          // DR-8: saved "Ma liste" works (reads + remove only; DR-9 owns the add)
}

// ── F-10 Media model ──────────────────────────────────────────────────────────

model Media {
  id          String          @id @default(cuid())
  ownerId     String
  owner       Account         @relation(fields: [ownerId], references: [id])
  kind        MediaKind
  bucketKey   String
  contentType String
  size        Int
  width       Int?
  height      Int?
  status      MediaStatus     @default(pending)
  variants    Json            @default("{}")
  visibility  MediaVisibility @default(public)
  createdAt   DateTime        @default(now())
  dataExport  DataExport?     // F-14: back-relation (one archive per export)

  @@index([ownerId])
  @@index([status, createdAt])
}

// ── F-14: DataExport ──────────────────────────────────────────────────────────

model DataExport {
  id          String           @id @default(cuid())
  accountId   String
  account     Account          @relation(fields: [accountId], references: [id])
  status      DataExportStatus @default(pending)
  mediaId     String?          @unique
  media       Media?           @relation(fields: [mediaId], references: [id])
  requestedAt DateTime         @default(now())
  readyAt     DateTime?
  expiresAt   DateTime?

  @@index([accountId, status])
  @@index([status, expiresAt]) // purge sweep
}

model Profile {
  id                   String          @id @default(cuid())
  accountId            String          @unique
  account              Account         @relation(fields: [accountId], references: [id])
  coverImage           String?
  specialty            String?
  city                 String?
  bio                  String?
  creatorRoles         String[]        @default([])  // F-17: onboarding Step 1 sub-roles (NOT authz role)
  seekingActive        Boolean         @default(false)
  seekingTargetRole    String?
  seekingGenres        String[]        @default([])
  seekingProjectLength String?
  tags                 String[]        @default([])
  portfolio            PortfolioItem[]
  trendingScore        Int             @default(0) // DR-1: denormalized "of the moment" rank; engagement pipeline recomputes later
  createdAt            DateTime        @default(now())

  @@index([trendingScore])
}

model PortfolioItem {
  id        String   @id @default(cuid())
  profileId String
  profile   Profile  @relation(fields: [profileId], references: [id])
  image     String
  caption   String?
  order     Int      @default(0)
  createdAt DateTime @default(now())
}

// ── F-11: Email verification token ───────────────────────────────────────────

model EmailVerificationToken {
  id         String    @id @default(cuid())
  accountId  String
  account    Account   @relation(fields: [accountId], references: [id])
  tokenHash  String    @unique      // sha256(raw); raw is never stored
  expiresAt  DateTime               // createdAt + 24h
  consumedAt DateTime?              // single-use: non-null once confirmed
  createdAt  DateTime  @default(now())

  @@index([accountId])
}

// ── F-12: Password reset token (mirrors F-11 EmailVerificationToken; TTL 1h) ──

model PasswordResetToken {
  id         String    @id @default(cuid())
  accountId  String
  account    Account   @relation(fields: [accountId], references: [id])
  tokenHash  String    @unique   // sha256(raw); raw is never stored
  expiresAt  DateTime            // createdAt + 1h
  consumedAt DateTime?           // single-use: non-null once used
  createdAt  DateTime  @default(now())

  @@index([accountId])
}

model Notification {
  id           String    @id @default(cuid())
  recipientId  String
  recipient    Account   @relation("NotifRecipient", fields: [recipientId], references: [id])
  type         NotifType
  refId        String?
  sourceUserId String?
  sourceUser   Account?  @relation("NotifSource", fields: [sourceUserId], references: [id])
  createdAt    DateTime  @default(now())
  readAt       DateTime?

  @@index([recipientId, readAt])
  @@index([recipientId, createdAt])
}

// ── F-13: Legal documents & consent records ───────────────────────────────────

// ── F-15: Notification & e-mail preferences ──────────────────────────────────

model NotificationPreference {
  id        String  @id @default(cuid())
  accountId String
  account   Account @relation(fields: [accountId], references: [id])
  type      String  // NotificationPrefType (string — forward-compatible with new categories)
  channel   String  // 'in_app' | 'email'
  enabled   Boolean

  @@unique([accountId, type, channel])
  @@index([accountId])
}

model LegalDocument {
  id          String    @id @default(cuid())
  kind        LegalKind
  version     String
  content     String    // trusted HTML
  publishedAt DateTime  @default(now())

  @@unique([kind, version])
  @@index([kind, publishedAt])
}

model ConsentRecord {
  id         String          @id @default(cuid())
  accountId  String
  account    Account         @relation(fields: [accountId], references: [id])
  document   ConsentDocument
  version    String
  acceptedAt DateTime        @default(now())
  ip         String?

  @@index([accountId, document])
}

// ── F-18: 2FA credential (one per account; enabledAt null = pending/unconfirmed) ──

model TwoFactorCredential {
  id               String    @id @default(cuid())
  accountId        String    @unique                 // one credential per account
  account          Account   @relation(fields: [accountId], references: [id])
  secretEncrypted  String                            // AES-256-GCM "iv:tag:ciphertext" (base64); never logged
  enabledAt        DateTime?                          // null = setup pending (secret issued, not confirmed)
  backupCodeHashes String[]  @default([])             // sha256(code) hex; single-use → removed on use
  createdAt        DateTime  @default(now())
}

// ── F-18: Email change token (mirrors F-11 EmailVerificationToken) ────────────

model EmailChangeToken {
  id         String    @id @default(cuid())
  accountId  String
  account    Account   @relation(fields: [accountId], references: [id])
  newEmail   String                                   // committed to Account.email on confirm
  tokenHash  String    @unique                        // sha256(raw); raw never stored (mirror F-11/F-12)
  expiresAt  DateTime                                 // createdAt + 24h
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([accountId])
}

// ── DR-1: home showroom (Work/Chapter/Announcement) ───────────────────────────
// "ScheduledRelease" and "Creator" from the story's entity list are NOT separate tables:
// a scheduled release IS a Chapter with status=scheduled + publishAt>now; a creator IS an
// existing Account+Profile (role via Profile.creatorRoles, see trendingScore above).

model Work {
  id                 String    @id @default(cuid())
  slug               String    @unique
  title              String
  coverImage         String?                          // media URL; null → CSS halftone placeholder on FE
  genre              String                            // display fr label — "Shōnen" | "Seinen" | "Fantastique" | "Josei" | …
                                                         // (DR-2 catalog GENRE facet accepts F-20 vocabulary ids in the
                                                         // query and maps id→fr via catalogGenreLabel() before filtering
                                                         // this column — see catalog.service.ts. Column itself is unchanged
                                                         // from DR-1: kept as the fr display label, reused verbatim by cards.)
  meta               String                            // hero/ranking meta line, e.g. "Léa B. × Hugo D. · 20 ch."
  likeCount          Int       @default(0)              // ponytail: denormalized total; DR-9 owns the increment
  weeklyLikeDelta    Int       @default(0)              // ponytail: rolling-7d delta; DR-9/DR-4 recompute from events
  priorWeekLikeDelta Int       @default(0)              // ponytail: prior-period delta for growth %; same note
  featuredRank       Int?                               // null = not in "À LA UNE"; else carousel order asc
  createdAt          DateTime  @default(now())
  chapters           Chapter[]

  // ── DR-2: catalog facet columns ──────────────────────────────────────────
  themes         String[] @default([])                 // CATALOG_THEMES subset (OR-in filter)
  format         String   @default("Manga")             // one of CATALOG_FORMATS
  language       String   @default("Français")          // one of CATALOG_LANGUAGES
  audienceRating String   @default("Tous publics")       // CATALOG_AUDIENCE_RATINGS — DR-10 reads this for 18+ gating
  complete       Boolean  @default(false)                // STATUT: true = "Œuvres complètes"
  chapterCount   Int      @default(0)                    // ponytail: denormalized card count + LONGUEUR filter; DR-3/CS own real counts
  ratingAvg      Float    @default(0)                    // ponytail: denormalized; PUB-3 reviews own it
  publishedAt    DateTime?                                // null = not in catalog; non-null = published + recency sort key
  editorPicks    EditorPick[]

  // ── DR-3: work page "Œuvre" columns ──────────────────────────────────────
  synopsis       String?                                  // "Synopsis" block body
  hashtags       String[] @default([])                    // "#..." chips under the synopsis
  proseExcerpt   String?                                  // roman-only excerpt body; response nulls it unless format==='Roman'
  readCount      Int      @default(0)                     // ponytail: denormalized; DR-4 owns the increment (reader open)
  favoriteCount  Int      @default(0)                      // ponytail: denormalized; DR-9 owns the increment
  ratingStoryAvg Float    @default(0)                     // ponytail: recomputed from Review rows in WorksService (not stored authoritative)
  ratingArtAvg   Float    @default(0)                     // same note
  reviewCount    Int      @default(0)                     // same note — DR-3 recomputes ratingStoryAvg/ratingArtAvg/reviewCount +
                                                            // an "overall" ratingAvg from Review rows in the service response; this
                                                            // stays the seed-set starting point, not the live source of truth (the
                                                            // existing `ratingAvg` column above stays the DR-2 catalog sort key —
                                                            // the two may differ until PUB-3 reconciles them).
  creators       WorkCreator[]
  planches       Planche[]
  fundingGoals   FundingGoal[]
  reviews        Review[]

  // ── DR-4: reader "Lecteur" ────────────────────────────────────────────────
  favoritedBy      Favorite[]        // DR-4 reads this list; DR-9 owns the toggle write + favoriteCount increment
  readingProgress  ReadingProgress[]

  // ── DR-8: "Ma liste" saved works ─────────────────────────────────────────
  watchlistedBy    WatchlistItem[]

  @@index([featuredRank])
  @@index([weeklyLikeDelta])
  @@index([likeCount])
  @@index([publishedAt])
  @@index([ratingAvg])
}

model Chapter {
  id           String        @id @default(cuid())
  workId       String
  work         Work          @relation(fields: [workId], references: [id])
  number       Int
  title        String?
  status       ChapterStatus @default(published)
  publishAt    DateTime      @default(now())              // future + status=scheduled → "Sorties programmées"
  createdAt    DateTime      @default(now())
  plancheCount Int           @default(0)                   // ponytail: denormalized; CS owns real page counts later
  likeCount    Int           @default(0)                   // ponytail: denormalized; DR-9 owns the increment

  // ── DR-4: reader "Lecteur" ────────────────────────────────────────────────
  premium         Boolean           @default(false)         // locked flag; stands in for MR-1/MR-4 access tier
  prose           String?                                   // roman chapter body; paragraphs separated by "\n\n"
  pages           Planche[]                                 // reader pages (chapterId set); DR-3 work-level planches keep chapterId=null
  readingProgress ReadingProgress[]

  @@index([status, publishAt])
  @@index([workId, number])
}

// ── DR-3: work page "Œuvre" (creative team, planches, funding goals, reviews) ──
// "CreatorMember" from the story's entity list is WorkCreator — a join row (Work × Account) with a
// per-work role/order, distinct from Profile.creatorRoles (DR-1, an account-level self-declared tag).

model WorkCreator {
  id        String  @id @default(cuid())
  workId    String
  work      Work    @relation(fields: [workId], references: [id])
  accountId String
  account   Account @relation(fields: [accountId], references: [id])
  role      String                                        // "scenariste" | "dessinateur" | …
  order     Int     @default(0)

  @@unique([workId, accountId])
}

model Planche {
  id        String   @id @default(cuid())
  workId    String
  work      Work     @relation(fields: [workId], references: [id])
  chapterId String?                                          // DR-4: set = reader page; null = DR-3 work-level grid planche
  chapter   Chapter? @relation(fields: [chapterId], references: [id])
  image     String?
  caption   String?
  order     Int      @default(0)

  @@index([workId, order])
  @@index([chapterId, order])
}

// ── DR-4: reader "Lecteur" (favorites switcher + reading progress) ───────────

model Favorite {
  id        String   @id @default(cuid())
  accountId String
  account   Account  @relation(fields: [accountId], references: [id])
  workId    String
  work      Work     @relation(fields: [workId], references: [id])
  createdAt DateTime @default(now())

  @@unique([accountId, workId])
  @@index([accountId])
}

model ReadingProgress {
  id        String   @id @default(cuid())
  accountId String
  account   Account  @relation(fields: [accountId], references: [id])
  chapterId String
  chapter   Chapter  @relation(fields: [chapterId], references: [id])
  workId    String
  work      Work     @relation(fields: [workId], references: [id])
  page      Int
  updatedAt DateTime @updatedAt

  @@unique([accountId, chapterId])
  @@index([accountId, updatedAt])
}

// ── DR-8: "Ma liste" saved works (watchlist) — read + remove only; DR-9 owns the add write ────

model WatchlistItem {
  id        String   @id @default(cuid())
  accountId String
  account   Account  @relation(fields: [accountId], references: [id])
  workId    String
  work      Work     @relation(fields: [workId], references: [id])
  createdAt DateTime @default(now())

  @@unique([accountId, workId])
  @@index([accountId, createdAt])
}

model FundingGoal {
  id           String @id @default(cuid())
  workId       String
  work         Work   @relation(fields: [workId], references: [id])
  title        String
  currentCents Int    @default(0)
  targetCents  Int
  order        Int    @default(0)

  @@index([workId, order])
}

model Review {
  id          String   @id @default(cuid())
  workId      String
  work        Work     @relation(fields: [workId], references: [id])
  authorId    String?                                      // nullable: seed fixtures have no real Account
  authorName  String
  storyRating Int
  artRating   Int
  text        String
  hidden      Boolean  @default(false)                      // AD-4/PUB-3 moderation flag; text blanked on the FE when true
  createdAt   DateTime @default(now())

  @@index([workId, createdAt])
}

model Announcement {
  id        String           @id @default(cuid())
  type      AnnouncementType
  label     String                                     // French rich text, verbatim from prototype ribbon
  href      String                                      // link target (future PUB-7/PUB-8 route)
  order     Int              @default(0)
  createdAt DateTime         @default(now())

  @@index([order])
}

// ── DR-2: catalog "Découvrir" (Contest banner + editor picks) ────────────────

model Contest {
  id        String    @id @default(cuid())
  category  String                                     // e.g. "CONCOURS"
  title     String                                     // "Prix du jeune mangaka 2026"
  subtitle  String                                     // "Doté par un éditeur · clôture 30 j"
  ctaLabel  String                                     // "Participer"
  href      String                                      // PUB-7 route target (link/banner only for now)
  active    Boolean   @default(true)
  endsAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([active])
}

model EditorPick {
  id        String   @id @default(cuid())
  workId    String
  work      Work     @relation(fields: [workId], references: [id])
  blurb     String                                      // "« Encre Blanche » repéré par une maison partenaire"
  order     Int      @default(0)
  createdAt DateTime @default(now())

  @@index([order])
}

// ── DR-5: illustration gallery "Galerie" ──────────────────────────────────────

model Illustration {
  id              String    @id @default(cuid())
  title           String
  artistId        String?                       // nullable like Review.authorId (seed fixtures may lack a real Account)
  artist          Account?  @relation(fields: [artistId], references: [id])
  artistName      String                        // denormalized display name (always present)
  category        String                        // GALLERY_CATEGORY_KEYS: personnages|couvertures|decors|fanart|process
  genres          String[]  @default([])        // Round 2: F-20 vocabulary fr labels (like Work.genre/themes) — genre[] facet
  image           String?                        // media URL; null -> CSS halftone placeholder (coverStyle)
  width           Int?                            // dimensions (DR-6/preview meta)
  height          Int?
  description     String?                        // DR-6: meta-block paragraph
  hashtags        String[]  @default([])        // DR-6: free descriptive chips ("#encre") — NOT F-20 genres
  tools           String?                        // DR-6: "Détails" -> Outils, e.g. "Encre · CSP"
  license         String?                        // DR-6: "Détails" -> Licence; null -> "© Tous droits réservés" (BE default)
  likeCount       Int       @default(0)          // ponytail: denormalized; DR-9 owns the increment
  weeklyLikeDelta Int       @default(0)          // rolling-7d delta -> "tendance" sort + trending endpoint
  publishedAt     DateTime?                        // null = not public; non-null = in gallery + "nouveautes" sort key
  createdAt       DateTime  @default(now())

  @@index([publishedAt])
  @@index([weeklyLikeDelta])
  @@index([likeCount])
  @@index([category])
}
