// ── MC-1: project calls "Appels à projets" ────────────────────────────────────
// MC-1 ships only the read-preview (GET /calls). MC-4 owns POST, the full board, board
// filters/pagination, and any extra fields — do not add write logic here.
model ProjectCall {
  id               String             @id @default(uuid(7)) @db.Uuid
  title            String // "« Lames de Brume »"
  authorRoles      String[]           @default([]) // MC-4X §8: the author's creator role(s), snapshot of profile.creatorRoles (was single authorRole)
  seekingRoles     String[]           @default([]) // MC-4X req6: role(s) sought (1..2, = seats keys); kept for the board `has` filter
  seats            Json               @default("{}") // MC-4X §8: seat counts per sought role, e.g. { "dessinateur": 2, "scenariste": 1 }
  projectId        String?            @db.Uuid // MC-4X req6: optional link to an author-owned Project
  project          Project?           @relation(fields: [projectId], references: [id])
  authorId         String?            @db.Uuid // nullable, seed-friendly (mirror Illustration.artistId)
  authorName       String // denormalized display name
  tags             String[]           @default([]) // denormalized display chips (genre labels + scope/format)
  description      String             @default("") // MC-4: card body text
  genres           String[]           @default([]) // MC-4: GENRES ids (F-20) — used for board filtering
  format           String? // MC-4: 'serie' | 'one_shot'
  scope            String? // MC-4: free text, e.g. "~120 planches"
  closesAt         DateTime? // null → FE meta falls back to applicationCount; MC-4: the deadline
  applicationCount Int                @default(0)
  status           String             @default("open") // MC-4 owns transitions
  closedReason     String? // MC-14: 'full' (auto, reopenable) | 'manual' (owner close/deadline, sticky) | null while open
  createdAt        DateTime           @default(now())
  applications     Application[] // MC-5: applications submitted to this call
  assets           ProjectCallAsset[] // MC-4X: sample images + PDF documents (was single sampleMediaId)

  @@index([status, createdAt])
  @@index([authorId])
  // DB pass 2026-08-02: every FK needs its own index. RESTRICT, SET NULL and CASCADE
  // all make Postgres look up child rows when a parent is deleted — unindexed that is a
  // sequential scan, and F-14 account erasure / CS-16 project delete hit exactly these.
  @@index([projectId])
}

// MC-4X: a call's sample images (kind 'call_sample') and PDF documents (kind 'call_document'),
// ordered by position. Asset TYPE lives on Media.kind (no assetType column). Composite PK — no
// surrogate id. Backfill preserved every pre-MC-4X call's single sampleMediaId at position 0.
model ProjectCallAsset {
  callId   String      @db.Uuid
  mediaId  String      @db.Uuid
  position Int
  call     ProjectCall @relation(fields: [callId], references: [id], onDelete: Cascade)

  @@id([callId, mediaId])
  @@index([callId, position])
}

// ── MC-5: Candidater — apply to a call ────────────────────────────────────────

enum ApplicationStatus {
  pending
  accepted
  rejected
}

model Application {
  id          String             @id @default(uuid(7)) @db.Uuid
  callId      String             @db.Uuid
  call        ProjectCall        @relation(fields: [callId], references: [id], onDelete: Cascade)
  applicantId String             @db.Uuid
  applicant   Account            @relation(fields: [applicantId], references: [id])
  sampleUrl   String // denormalized display URL of the FIRST sample — MC-6/MC-7 render this thumbnail
  message     String             @default("")
  status      ApplicationStatus  @default(pending)
  appliedAs   String? // the CreatorRole the applicant applied AS (server-derived = call seekingRole); null on historical rows
  createdAt   DateTime           @default(now())
  assets      ApplicationAsset[] // MC-4X: 1..3 mixed samples (was single sampleMediaId/samplePortfolioItemId)

  @@unique([callId, applicantId]) // one application per user per call — DB-level backstop
  @@index([applicantId, createdAt]) // MC-6 "Mes candidatures" reads
}

// MC-4X: an application's samples (1..3), each an uploaded Media (image/PDF) XOR a PortfolioItem,
// ordered by position. Display info denormalized (url/kind/size) so reads need no join — mirrors the
// existing Application.sampleUrl denormalization. Backfill preserved the single sample at position 0.
model ApplicationAsset {
  applicationId   String      @db.Uuid
  application     Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  mediaId         String?     @db.Uuid // F-10 Media.id (kind 'application_sample' | 'application_document'), FK-by-convention
  portfolioItemId String?     @db.Uuid // F-3 PortfolioItem.id — FK-by-convention
  url             String // denormalized display URL (image thumb / portfolio image / document CDN url)
  kind            String // 'image' | 'document'
  size            Int? // bytes — documents only
  position        Int

  @@id([applicationId, position])
  @@index([applicationId])
}

// ── DR-2: catalog "Découvrir" (Contest banner + editor picks) ────────────────

model Contest {
  id        String    @id @default(uuid(7)) @db.Uuid
  category  String // e.g. "CONCOURS"
  title     String // "Prix du jeune mangaka 2026"
  subtitle  String // "Doté par un éditeur · clôture 30 j"
  ctaLabel  String // "Participer"
  href      String // PUB-7 route target (link/banner only for now)
  active    Boolean   @default(true)
  endsAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([active])
}

model EditorPick {
  id        String   @id @default(uuid(7)) @db.Uuid
  workId    String   @db.Uuid
  work      Work     @relation(fields: [workId], references: [id])
  blurb     String // "« Encre Blanche » repéré par une maison partenaire"
  order     Int      @default(0)
  createdAt DateTime @default(now())

  @@index([order])
  // DB pass 2026-08-02: every FK needs its own index. RESTRICT, SET NULL and CASCADE
  // all make Postgres look up child rows when a parent is deleted — unindexed that is a
  // sequential scan, and F-14 account erasure / CS-16 project delete hit exactly these.
  @@index([workId])
}

// ── DR-5: illustration gallery "Galerie" ──────────────────────────────────────

model Illustration {
  id              String    @id @default(uuid(7)) @db.Uuid
  title           String
  artistId        String?   @db.Uuid // nullable like Review.authorId (seed fixtures may lack a real Account)
  artist          Account?  @relation(fields: [artistId], references: [id])
  artistName      String // denormalized display name (always present)
  category        String // GALLERY_CATEGORY_KEYS: personnages|couvertures|decors|fanart|process
  genres          String[]  @default([]) // Round 2: F-20 vocabulary fr labels (like Work.genre/themes) — genre[] facet
  image           String? // media URL; null -> CSS halftone placeholder (coverStyle)
  width           Int? // dimensions (DR-6/preview meta)
  height          Int?
  description     String? // DR-6: meta-block paragraph
  hashtags        String[]  @default([]) // DR-6: free descriptive chips ("#encre") — NOT F-20 genres
  tools           String? // DR-6: "Détails" -> Outils, e.g. "Encre · CSP"
  license         String? // DR-6: "Détails" -> Licence; null -> "© Tous droits réservés" (BE default)
  likeCount       Int       @default(0) // ponytail: denormalized; DR-9 owns the increment
  weeklyLikeDelta Int       @default(0) // rolling-7d delta -> "tendance" sort + trending endpoint
  publishedAt     DateTime? // null = not public; non-null = in gallery + "nouveautes" sort key
  createdAt       DateTime  @default(now())
  // CS-1 (induced): a standalone illustration is also contest-linkable + supportable.
  contestId       String?   @db.Uuid // FK-by-convention link to Contest (validated in service; no Prisma relation)
  soutien         Json? // ponytail: raw {tiers,allowDonations,goals}; goals folded in here (no workId) — MR-1/MR-2 normalize later

  collections IllustrationCollection[] // DR-12: collections (Illustration(s) Works) this piece belongs to

  @@index([publishedAt])
  @@index([weeklyLikeDelta])
  @@index([likeCount])
  @@index([category])
  // DB pass 2026-08-02: every FK needs its own index. RESTRICT, SET NULL and CASCADE
  // all make Postgres look up child rows when a parent is deleted — unindexed that is a
  // sequential scan, and F-14 account erasure / CS-16 project delete hit exactly these.
  @@index([artistId])
}

// ── DR-12: illustration collections (many-to-many, ordered per collection) ────
// A collection is a Work with format 'Illustration(s)'. This join carries the membership + per-
// collection ordering. Composite-unique on (illustrationId, workId) — dedup on re-add; both sides
// cascade-delete (deleting the collection Work or the Illustration removes the membership row).
model IllustrationCollection {
  illustrationId String       @db.Uuid
  illustration   Illustration @relation(fields: [illustrationId], references: [id], onDelete: Cascade)
  workId         String       @db.Uuid
  work           Work         @relation(fields: [workId], references: [id], onDelete: Cascade)
  order          Int          @default(0)

  @@id([illustrationId, workId])
  @@index([workId, order])
}

// ── F-21: support & contact tickets (help/contact/bug channel) ────────────────
// Submit is public (visitors + members). Reading/triage is AD-14's job — this model +
// the [status, createdAt] index make tickets staff-listable; no read endpoint ships here.

model SupportTicket {
  id        String   @id @default(uuid(7)) @db.Uuid
  category  String // allowlisted in DTO: general | account | bug | other
  accountId String?  @db.Uuid // nullable — visitors submit too
  account   Account? @relation(fields: [accountId], references: [id])
  name      String
  email     String
  message   String
  context   Json? // { url?, userAgent?, requestId? } for bug reports
  status    String   @default("new") // new | open | resolved (AD-14 owns transitions)
  createdAt DateTime @default(now())

  @@index([accountId])
  @@index([status, createdAt]) // AD-14 staff triage listing
}

// ── CS-2: project workspace kanban (Espace projet) ───────────────────────────
// `Page` is a KANBAN BOARD CARD (script→validated art tracking), NOT `Planche`
// (the published reader page). Distinct concept, distinct table on purpose.

enum PageStage {
  scenario
  nemu
  corrections
  propre
  encrage
  valide
}

model Page {
  id             String              @id @default(uuid(7)) @db.Uuid
  projectId      String              @db.Uuid
  project        Project             @relation(fields: [projectId], references: [id])
  // CS-7 R2-1d (user rule, 2026-07-31): EVERY card belongs to a chapter. There is no orphan bucket —
  // a nullable column is what made the forbidden state representable, so the invariant is enforced
  // here, not in app code. Deleting a chapter that still holds cards is a 409 (R2-6), never a cascade.
  chapterId      String              @db.Uuid
  chapter        Chapter             @relation("ChapterBoardCards", fields: [chapterId], references: [id])
  title          String // card label, e.g. "Page 7"
  stage          PageStage           @default(scenario)
  fileTags       String[]            @default([]) // PAGE_FILE_TAGS subset: scenario|ref|nemu|double
  // CS-7 R8 — the card's SLOT within its chapter (dense 0..n-1, rewritten on every move). Displayed
  // page numbers are DERIVED from it (`chapterPageNumbers`), a `double` card spanning two of them.
  // Plain index, not @@unique: the service rewrites the whole permutation, which a unique constraint
  // would fight mid-transaction (same call as IllustrationCollection.order).
  position       Int                 @default(0)
  linkedFileIds  String[]            @default([]) @db.Uuid // CS-3 Asset/Media ids — stored, not resolved here
  description    String? // CS-2 card-modal: free-text card description
  dueDate        DateTime? // CS-2 card-modal: deadline (date-only; serialized YYYY-MM-DD)
  // CS-10 D-1: who created the card. Nullable because the column landed after the table existed —
  // the migration backfills every pre-existing row to the project owner, and `null` is treated as
  // LEADERSHIP-ONLY at the gate, so a failed/partial backfill fails closed rather than open.
  createdById    String?             @db.Uuid
  createdBy      Account?            @relation("PageAuthor", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  labels         PageLabel[] // CS-2 card-modal: applied labels
  assignees      PageAssignee[] // CS-2 card-modal: assigned members
  checklistItems PageChecklistItem[] // CS-2 card-modal: checklist rows
  comments       PageComment[] // CS-2 card-modal: comments
  assetLinks     AssetPageLink[] // CS-3 assets linked to this card (2026-07-14 many-to-many join)
  corrections    Correction[] // CS-5 review corrections filed against this card

  @@index([projectId, chapterId, stage])
  @@index([createdById])
  @@index([chapterId, position])
}

// ── CS-2 card-modal extension: labels, checklist, comments, assignees ──────────

model ProjectLabel {
  id        String      @id @default(uuid(7)) @db.Uuid
  projectId String      @db.Uuid
  project   Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name      String // ≤30, trimmed (validated in the DTO/service)
  color     String // hex ∈ LABEL_COLORS (validated in the service)
  createdAt DateTime    @default(now())
  pages     PageLabel[]

  @@index([projectId])
}

model PageLabel {
  pageId  String       @db.Uuid
  page    Page         @relation(fields: [pageId], references: [id], onDelete: Cascade)
  labelId String       @db.Uuid
  label   ProjectLabel @relation(fields: [labelId], references: [id], onDelete: Cascade)

  @@id([pageId, labelId])
  // DB pass 2026-08-02: every FK needs its own index. RESTRICT, SET NULL and CASCADE
  // all make Postgres look up child rows when a parent is deleted — unindexed that is a
  // sequential scan, and F-14 account erasure / CS-16 project delete hit exactly these.
  @@index([labelId])
}

model PageAssignee {
  pageId     String   @db.Uuid
  page       Page     @relation(fields: [pageId], references: [id], onDelete: Cascade)
  userId     String   @db.Uuid
  user       Account  @relation("PageAssignee", fields: [userId], references: [id])
  assignedAt DateTime @default(now())

  @@id([pageId, userId])
  // DB pass 2026-08-02: every FK needs its own index. RESTRICT, SET NULL and CASCADE
  // all make Postgres look up child rows when a parent is deleted — unindexed that is a
  // sequential scan, and F-14 account erasure / CS-16 project delete hit exactly these.
  @@index([userId])
}

model PageChecklistItem {
  id     String  @id @default(uuid(7)) @db.Uuid
  pageId String  @db.Uuid
  page   Page    @relation(fields: [pageId], references: [id], onDelete: Cascade)
  text   String
  done   Boolean @default(false)
  order  Int

  @@index([pageId, order])
}

model PageComment {
  id        String    @id @default(uuid(7)) @db.Uuid
  pageId    String    @db.Uuid
  page      Page      @relation(fields: [pageId], references: [id], onDelete: Cascade)
  authorId  String    @db.Uuid
  author    Account   @relation("PageCommentAuthor", fields: [authorId], references: [id])
  body      String
  createdAt DateTime  @default(now())
  editedAt  DateTime?

  @@index([pageId, createdAt])
  // DB pass 2026-08-02: every FK needs its own index. RESTRICT, SET NULL and CASCADE
  // all make Postgres look up child rows when a parent is deleted — unindexed that is a
  // sequential scan, and F-14 account erasure / CS-16 project delete hit exactly these.
  @@index([authorId])
}

// ── CS-3: project assets (versioned logical files) ─────────────────────────────

enum AssetType {
  dessin
  texte
  scenario
  ref
  page
}

model Asset {
  id             String            @id @default(uuid(7)) @db.Uuid
  projectId      String            @db.Uuid
  project        Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  type           AssetType
  filename       String
  currentVersion Int               @default(1)
  size           Int // denormalized current-version size → sort=size is one indexed orderBy
  mediaId        String            @db.Uuid // current version's Media id (denormalized head of the chain)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  versions       AssetVersion[]
  pageLinks      AssetPageLink[] // CS-3 cards this asset is linked to (2026-07-14; scenario/texte/ref = many, dessin/page = one)
  scenarioDoc    ScenarioDocument? // CS-4: the editor working draft backed by this scenario asset (1:1)
  corrections    Correction[] // CS-5 review corrections filed against this file

  @@unique([projectId, filename]) // D10 re-import rule
  @@index([projectId, type])
  @@index([projectId, updatedAt]) // sort=recent
}

// CS-3 (2026-07-14): asset↔card link join. Replaces the single Asset.linkedPageId. A scenario/texte/
// ref asset may have many rows (shared across cards); a dessin/page asset keeps at most one (re-link
// replaces). Both sides cascade-delete. `@@index([pageId])` backs the ?pageId= list filter + the
// per-card derivation (Page.assetLinks).
model AssetPageLink {
  assetId   String   @db.Uuid
  asset     Asset    @relation(fields: [assetId], references: [id], onDelete: Cascade)
  pageId    String   @db.Uuid
  page      Page     @relation(fields: [pageId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([assetId, pageId])
  @@index([pageId])
}

model AssetVersion {
  id        String   @id @default(uuid(7)) @db.Uuid
  assetId   String   @db.Uuid
  asset     Asset    @relation(fields: [assetId], references: [id], onDelete: Cascade)
  version   Int
  mediaId   String   @db.Uuid
  size      Int
  note      String?
  authorId  String   @db.Uuid
  author    Account  @relation("AssetVersionAuthor", fields: [authorId], references: [id])
  createdAt DateTime @default(now())

  @@unique([assetId, version]) // linear chain, no branching
  // DB pass 2026-08-02: every FK needs its own index. RESTRICT, SET NULL and CASCADE
  // all make Postgres look up child rows when a parent is deleted — unindexed that is a
  // sequential scan, and F-14 account erasure / CS-16 project delete hit exactly these.
  @@index([authorId])
}

// ── CS-4: collaborative script editor ──────────────────────────────────────────

// The editor's working draft — 1:1 with a scenario Asset. ydocState = merged Yjs binary (opaque to
// the API); contentJson = readable PlancheDoc projection (the PUB-1-exploitable structured artifact).
// Both written by autosave PATCH — never touches the AssetVersion chain.
model ScenarioDocument {
  id          String            @id @default(uuid(7)) @db.Uuid
  assetId     String            @unique @db.Uuid
  asset       Asset             @relation(fields: [assetId], references: [id], onDelete: Cascade)
  ydocState   Bytes
  contentJson Json
  // CS-4 item 20/26 — document scheme: 'manga' (case/description/dialogue) | 'prose' (plain rich text).
  // Persisted in place by autosave (no version bump) so reopening restores the writer's choice.
  template    String            @default("manga")
  updatedAt   DateTime          @updatedAt
  updates     ScenarioUpdate[]
  comments    ScenarioComment[]
}

// Append-only live-update log between autosaves (opaque Yjs update bytes). Cleared (compacted) by
// each autosave PATCH in the same transaction.
model ScenarioUpdate {
  id         String           @id @default(uuid(7)) @db.Uuid
  documentId String           @db.Uuid
  document   ScenarioDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  update     Bytes
  createdAt  DateTime         @default(now())

  @@index([documentId, createdAt])
}

// Per-case comments (right sidebar), keyed by document + case number.
model ScenarioComment {
  id         String           @id @default(uuid(7)) @db.Uuid
  documentId String           @db.Uuid
  document   ScenarioDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  caseNo     Int
  authorId   String           @db.Uuid
  author     Account          @relation("ScenarioCommentAuthor", fields: [authorId], references: [id])
  text       String
  // CS-4 item 5 — optional highlighted-text anchor: ProseMirror positions (best-effort) + the durable
  // quoted snippet shown as the sidebar indicator. All null → a plain case-level comment.
  anchorFrom Int?
  anchorTo   Int?
  quote      String?
  // CS-5 Fb-7 — the asset version the comment was filed against (null for pre-CS-5-r2 rows).
  version    Int?
  // CS-5 Fb-2 — 1:1 back-relation when this comment IS a tagged scenario correction request.
  correction Correction?
  createdAt  DateTime         @default(now())

  @@index([documentId, caseNo, createdAt])
  // DB pass 2026-08-02: every FK needs its own index. RESTRICT, SET NULL and CASCADE
  // all make Postgres look up child rows when a parent is deleted — unindexed that is a
  // sequential scan, and F-14 account erasure / CS-16 project delete hit exactly these.
  @@index([authorId])
}

// ── CS-5: review corrections ───────────────────────────────────────────────────

enum CorrectionType {
  scenario
  dessin
}

enum CorrectionStatus {
  a_corriger
  en_cours
  corrige
}

// One unified correction with a polymorphic anchor. scenario → { documentId, from, to, quote }
// (the CS-4 comment text-anchor); dessin → { region: { x, y, w, h } } normalized 0–1. Filed against a
// CS-3 AssetVersion (head at creation), addressed when a newer version resolves it (resolvedInVersion).
model Correction {
  id                  String           @id @default(uuid(7)) @db.Uuid
  pageId              String           @db.Uuid
  page                Page             @relation(fields: [pageId], references: [id], onDelete: Cascade)
  type                CorrectionType
  anchor              Json
  assetId             String           @db.Uuid // the file under review (scenario doc's backing asset | dessin image asset)
  asset               Asset            @relation(fields: [assetId], references: [id], onDelete: Cascade)
  caseRef             String? // optional "case N" tag shown in the list row
  description         String // "what specifically" — required
  status              CorrectionStatus @default(a_corriger)
  authorId            String           @db.Uuid
  author              Account          @relation("CorrectionAuthor", fields: [authorId], references: [id])
  assigneeId          String?          @db.Uuid
  filedAgainstVersion Int // AssetVersion.version reviewed (head at creation)
  resolvedInVersion   Int? // stamped when marked corrige
  // CS-5 Fb-2 — a scenario correction IS a tagged CS-4 comment. 1:1 link; deleting the comment (editor
  // path) cascades this correction. Legacy scenario corrections keep commentId = null (no comment).
  commentId           String?          @unique @db.Uuid
  comment             ScenarioComment? @relation(fields: [commentId], references: [id], onDelete: Cascade)
  createdAt           DateTime         @default(now())

  @@index([pageId, type, status, createdAt])
  @@index([assetId, status])
  // DB pass 2026-08-02: every FK needs its own index. RESTRICT, SET NULL and CASCADE
  // all make Postgres look up child rows when a parent is deleted — unindexed that is a
  // sequential scan, and F-14 account erasure / CS-16 project delete hit exactly these.
  @@index([authorId])
}
