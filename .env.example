# Copy to .env and fill in. Never commit real secrets.

# --- Database (per-environment) ---
DATABASE_URL="postgresql://postgres:postgres@localhost:6432/encre_et_plume?schema=public&pgbouncer=true&connection_limit=10&pool_timeout=10&connect_timeout=5"
# Migrations, seeding and psql bypass the pooler — Prisma Migrate needs one stable session.
DIRECT_DATABASE_URL="postgresql://postgres:postgres@localhost:5433/encre_et_plume?schema=public"

# --- API ---
API_PORT=3001
JWT_SECRET="change-me"
REDIS_URL="redis://localhost:6379"
# Browser origin(s) allowed by API CORS (credentials). The WEB app, not the API. Comma-separate for many.
WEB_ORIGIN="http://localhost:3000"
# Run the BullMQ job workers INSIDE the API process (F-8/F-10). Set "true" for local dev so `pnpm dev`
# processes jobs (image-processing → Media ready) with no separate worker. In prod leave empty and run a
# dedicated worker (`node dist/worker.js`) — don't run both at once.
WORKER_INLINE=""

# --- Web ---
NEXT_PUBLIC_API_URL="http://localhost:3001"

# --- Observability (F-9) ---
# Sentry: leave empty for NO-OP (CI/local need no Sentry account)
SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DSN=""
SENTRY_RELEASE=""
SENTRY_AUTH_TOKEN=""
SENTRY_ENVIRONMENT="development"
SENTRY_TRACES_SAMPLE_RATE="0"
# Metrics: optional bearer token for /metrics endpoint (leave empty = open on private networks)
METRICS_TOKEN=""
# Logging: log | warn | error | debug | verbose
LOG_LEVEL="log"

# --- E-mail (SMTP) ---
# Transport selection: SMTP_HOST set => real SMTP (nodemailer); empty => log transport
# (messages printed to the worker log — used by CI and any env without a mail server).
# Local dev: MailHog via docker-compose — SMTP_HOST=localhost, SMTP_PORT=1025,
#            SMTP_SECURE=false, no auth; inbox UI at http://localhost:8025.
# Prod: your SMTP provider's host/port/credentials (set as deploy secrets, see below);
#       SMTP_SECURE=true for implicit TLS (465), false for STARTTLS (587).
#       Remember SPF/DKIM/DMARC on the sending domain.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
EMAIL_FROM="Encre & Plume <no-reply@example.com>"

# --- Stripe ---
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""

# --- Media storage (F-10): S3-compatible object storage + CDN ---
# Works with AWS S3 / Cloudflare R2 / MinIO.
# Leave S3_ENDPOINT empty for real AWS S3 (forcePathStyle disabled automatically).
# Local dev: MinIO on :9000 (docker-compose), bucket auto-created by scripts/setup-minio.sh.
S3_ENDPOINT=""
S3_REGION="us-east-1"
S3_BUCKET="encre-et-plume-media"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
CDN_BASE_URL="http://localhost:9000/encre-et-plume-media"
MEDIA_SIGNED_URL_TTL="300"

# ---------------------------------------------------------------------------
# CD secrets (set in GitHub repo/Environment secrets, NOT here).
# The deploy workflow looks for these, prefixed per environment (DEV_/STAGING_/PROD_):
#   <ENV>_DATABASE_URL          e.g. PROD_DATABASE_URL
#   <ENV>_VERCEL_TOKEN          web deploy (Vercel)
#   <ENV>_VERCEL_ORG_ID
#   <ENV>_VERCEL_PROJECT_ID
#   <ENV>_API_DEPLOY_HOOK       api deploy hook (Railway/Render/Fly)
#   <ENV>_SMTP_HOST / _SMTP_PORT / _SMTP_SECURE / _SMTP_USER / _SMTP_PASS / _EMAIL_FROM
#                               transactional e-mail via SMTP (e.g. PROD_SMTP_HOST)
# Deploy steps no-op until the matching secrets exist.
